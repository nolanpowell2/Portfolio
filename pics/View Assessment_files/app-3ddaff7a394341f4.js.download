`},971867(e){e.exports=`<div class="dropdown-directive">
  <select id="{{::listId}}" ng-if="::dropdown.useNativeSelect()" ng-model="dropdown.selectedItem"
          ng-options="item.name disable when item.isHeader for item in itemList"
          ng-class="{'drowdown-group': listKind === 'group'}"
          ng-change="dropdown.clickItem()" analytics-id="directives.dropdown.item.select"
          >
    <!--for the listkind=group, ios mobile will show a blank option-->
    <option ng-if="dropdown.shouldHaveBlankOption(listKind)" class="default-option" value="" analytics-id="directive.dropdown.option"></option>
  </select>

  <ul ng-attr-role="{{dropdown.getRole()}}"
      ng-class="{'feature-filter': listKind !== 'custom', 'selection-full-width': selectionFullWidth(), 'force-above': forceAbove}"
      id="{{::listId}}" ng-if="::!dropdown.useNativeSelect()" class="f-dropdown ignore-accordion" data-dropdown-content
      aria-hidden="true" tabindex="-1"
      ng-keydown="handleDropdownKeyEvents($event)">
    <li class="list-header" ng-if="listHeader">
      <a href="javascript:void(0);"
         analytics-id="{{::analyticsIdTagPrefix}}.listHeader.link"
      >
        {{listHeader}}
      </a>
    </li>
    <li ng-repeat="item in itemList" ng-if="listKind === 'filter'"
        class="{{item.extraClass}}"
    >
      <a href="javascript:void(0);"
         role="option"
         aria-selected="{{selectedItem === item}}"
         aria-setsize="{{itemList.length}}"
         aria-posinset="{{itemList.indexOf(item) + 1}}"
         class="js-filter-id-{{::item.index}}"
         data-filter-id="{{::item.nature.toString()}}"
         ng-click="dropdown.selectItem(item)"
         analytics-id="{{::analyticsIdTagPrefix}}.{{item.name.split(' ').join('')}}.link">
        <span class="ellipse" title="{{item.name}}">{{item.name}}</span>
        <i></i>
      </a>
    </li>
    <li  ng-repeat="item in itemList" ng-if="listKind === 'avatar-list'">
      <a role="option" href="javascript:void(0);"
         class="item-container"
         analytics-id="{{::analyticsIdTagPrefix}}.{{item.name}}.avatar.link">
        <div class="info-container">
          <div class="avatar-container">
            <bb-avatar user="item" inactive="!dropdown.isUserCourseAvailable(item.id)"></bb-avatar>
          </div>
          <div class="username-container">
            <bb-username user="item" format="short" show-pronouns="true" show-pronunciation="true"></bb-username>
            <div ng-if="selectedItem === item" class="sub-text" ng-bind-html="selectedText"></div>
          </div>
        </div>
      </a>
    </li>
    <li ng-if="listKind === 'group'" ng-repeat="item in itemList"
        ng-class="{'group-header-li': item.isHeader }">
      <a href="javascript:void(0);"
         role="option"
         aria-setsize="{{itemList.length}}"
         aria-posinset="{{itemList.indexOf(item) + 1}}"
         ng-class="{'group-header': item.isHeader}"
         ng-attr-tabindex="{{ item.isHeader ? -1 : 0 }}"
         ng-click="dropdown.selectItem(item, $event)"
         analytics-id="{{::analyticsIdTagPrefix}}.{{item.name}}.group.link">
        <span class="ellipse" title="{{item.name}}">{{item.name}}</span>
      </a>
    </li>
    <div bb-dropdown-transclude></div>
  </ul>
</div>
`},134017(e){e.exports=`<div class="timestamp" bb-load-bundle="components/directives/duration" ng-cloak bb-cache-compilation="duration-directive">
  <div ng-if="!duration.needAgo()">
