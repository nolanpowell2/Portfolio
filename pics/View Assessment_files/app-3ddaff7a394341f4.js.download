`},846133(e){e.exports=`<bb-modal class="notification automatic-zero-setting-confirmation"
          modal-translate-options="modalTranslateOptions"
          modal-aria-type="alertdialog"
          analytics-id-tag-prefix="components.directives.pastDueZeroSettings">
  <div name="modal-contents">
    <!-- Instructions -->
    <p bb-translate>{{ modalTranslateOptions.instructions.key }}</p>
    <!-- Past due zero: Unassign zero -->
    <div ng-if="!pastDueZero.isPastZeroAssigned">
      <fieldset ng-if="modalTranslateOptions.choices && modalTranslateOptions.choices.length > 0"
                class="fieldset-options">
        <legend class="sr-only" bb-translate="{{ modalTranslateOptions.title.key }}"></legend>
        <div class="option-item" ng-repeat="option in modalTranslateOptions.choices">
          <input type="radio" 
                 name="{{ ::option.name }}" 
                 id="{{ ::option.id }}"
                 ng-model="modalTranslateOptions.choiceModal"
                 ng-value="option.value"
                 analytics-id="components.directives.grade.pastDueZero.option.input.radio">
          <label for="{{ ::option.id }}" bb-translate>{{ ::option.localizedKey }}</label>
          <p ng-if="!!option.descriptionKey"
             class="past-due-unassign-description"
             bb-translate>
            {{ ::option.descriptionKey }}
          </p>
        </div>
      </fieldset>
    </div>
  </div>
  <button name="modal-footer-button-primary" 
          type="button" 
          class="button confirm-ok js-primary-button" 
          ng-click="okAction()" 
          analytics-id="{{modalTranslateOptions.confirm.key}}"
          bb-translate>
    {{modalTranslateOptions.confirm.key}}
  </button>
  <button name="modal-footer-button-secondary" 
          type="button" 
          class="button button--secondary confirm-cancel js-secondary-button" 
          ng-click="cancelAction()" 
          analytics-id="{{modalTranslateOptions.cancel.key}}"
          bb-translate>
    {{modalTranslateOptions.cancel.key}}
  </button>
</bb-modal>`},959235(e){e.exports=`<bb-modal class="notification automatic-zero-confirmation" 
