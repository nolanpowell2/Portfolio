     ng-multi-transclude-controller ng-attr-aria-label="{{::modal.titleString}}" ng-keydown="modal.handleKeyDown($event)">
  <div class="reveal-modal__header">
    <h1 class="reveal-modal__title" aria-describedby="modal-contents">
      {{::modal.titleString}}
    </h1>
    <button class="close-reveal-modal standard-button light-background" 
            ng-click="modal.dismiss()" 
            bb-translate-attrs="{ 'aria-label': 'global.close' }"
            analytics-id="{{modal.analyticsIdTagPrefix}}.modal.close.button">
      <bb-svg-icon size="small" icon="close"></bb-svg-icon>
    </button>
  </div>
  <div id="modal-contents" class="reveal-modal__contents" ng-multi-transclude="modal-contents"></div>
  <footer ng-multi-transclude="modal-footer" class="reveal-modal__footer">
    <div class="reveal-modal__footer-content reveal-modal__footer-content--gray">
      <div ng-multi-transclude="modal-footer-help-link" class="reveal-modal__footer-help-link-container"></div>
      <div class="reveal-modal__footer-buttons">
        <span ng-multi-transclude="modal-footer-button-secondary" class="reveal-modal__footer-button-container"></span>
        <span ng-multi-transclude="modal-footer-button-primary" class="reveal-modal__footer-button-container"></span>
      </div>
    </div>
  </footer>
  <div class="reveal-modal__dismiss" ng-class="{ 'hide' : !modal.dismissString }">
    <span class="reveal-modal__divider"></span>
    <button class="button button--text dismiss-message expand" ng-click="modal.dismiss()" analytics-id="{{modal.analyticsIdTagPrefix}}..modal.dismiss.button">
      <span>{{::modal.dismissString}}</span>
    </button>
  </div>
</div>
`},319929(e){e.exports=`<span ng-switch on="$ctrl.iconName" class="overflow-menu-icon">
  <bb-ui-icon-small-course-complete ng-switch-when="course-complete"></bb-ui-icon-small-course-complete>
