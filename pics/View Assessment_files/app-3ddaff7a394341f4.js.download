</bb-modal>
`},981442(e){e.exports=`<bb-modal class="notification"
          modal-title-key="components.directives.cloudStorageIntegration.modal.errorTitle"
          analytics-id-tag-prefix="components.directives.cloudStorageIntegration">
  <div name="modal-contents">
    <p bb-translate>components.directives.cloudStorageIntegration.modal.errorFull</p>
  </div>
  <button name="modal-footer-button-primary" class="button dismiss-button js-primary-button" ng-click="$parent.$dismiss()" analytics-id="components.directives.cloudStorageIntegration.modal.cancelUploadText">
    <bb-translate>components.directives.cloudStorageIntegration.modal.cancelUploadText</bb-translate>
