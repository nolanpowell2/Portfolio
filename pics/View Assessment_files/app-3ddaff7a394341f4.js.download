 0-.54-1.194-.625-.824M69.954 43.843l.17 9.95" stroke="#000" stroke-width=".569" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/><path d="M77.26 34.69c.312-.995-.711-1.65-.597-2.73.312-2.928 1.904-5.401 2.956-8.073 2.132-5.459 2.53-13.078-.597-17.825-3.155-4.776-9.95-6.112-14.64-3.525-4.009 2.217-7.96 4.32-9.95 15.266-1.251 6.823-.683 9.95 1.336 13.22 2.018 3.809 7.277 8.272 7.76 13.616 0 0 2.161-1.137 3.298-3.383 0 0 4.634 3.355 5.373 5.43-.028.029 5.487-8.841 5.06-11.996ZM67.85 9.985c7.96.768 9.523 3.781 9.523 7.05 0 4.776-2.615 9.61-3.582 11.827-.739 1.705-1.108 3.809-.625 5.6-.938-1.08-2.7-1.592-3.781-2.331 0 0-8.5-3.44-10.149-10.69-.74-3.268-.142-12.309 8.614-11.456Z" fill="#DA80A0"/><path d="M77.402 13.766c-6.738-6.197-15.238-4.918-17.796.74-2.104 4.633-1.934 13.531 13.56 19.132 2.16.796 1.791 7.277-2.502 4.974M80.415 11.435c.91-12.65-12.992-12.281-16.488-9.012" stroke="#000" stroke-width=".569" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/><path d="M66.713 40.432a33.83 33.83 0 0 1-3.213 4.236c-.511-8.7-10.632-11.144-10.206-23.312.143-4.179 3.554-17.568 16.262-16.772M67.85 42.166c1.45.91 2.729 2.16 3.752 3.639.171.256.455.569.711.426a.865.865 0 0 0 .228-.227c1.051-1.507 1.734-3.326 2.388-5.089l2.302-6.225" stroke="#000" stroke-width=".569" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/></svg>'},750829(e){e.exports=`<div id="aria-live-polite-region-1" class="sr-only" role="status" aria-live="polite"></div>
<div id="aria-live-polite-region-2" class="sr-only" role="status" aria-live="polite"></div>
<div id="aria-live-assertive-region-1" class="sr-only" role="alert" aria-live="assertive" aria-atomic="true"></div>
