    <div class="progress-indicator icon">
      <i class="{{::toastIcon()}}"></i>
    </div>
    <span class="progress-status {{::toastClass()}}">
    </span>
  </div>
</div>
`},735241(e){e.exports='<div class="complex-statistic-contents"></div>'},187705(e){e.exports=`<div class="simple-statistic-contents" ng-class="::item().cssClass">
  <div bb-tooltip enhanced-tooltip="true" data-tooltip-on-overflow-only="true" title="{{ ::item().data }}">
    <div class="stat-data"
         ng-attr-aria-label="{{ item().aria ? item().aria : undefined }}"
         data-ng-bind-html="::item().trusted"
         data-ellipsis></div>
  </div>
  <div ng-if="::item().subtext" class="stat-sub-text" bb-translate>{{ ::item().subtext }}</div>
  <div ng-if="::!item().subtext && item().reserveSubtextSpace" class="stat-sub-text" aria-hidden="true">&nbsp;</div>
</div>`},647711(e){e.exports=`<div class="bb-statistics">
  <ul class="statistics-list total-items-{{::statistics.total}} small-per-row-{{::statistics.smallPerRow}} large-per-row-{{::statistics.largePerRow}}">
    <li ng-repeat="item in statistics.config">
      <div class="statistics-item-container" ng-class="{'no-default-padding': item.noDefaultPadding, 'full-height': !item.complexScope}">
        <div class="stat-title" ng-attr-title="{{ item.hover ? item.hover : undefined }}" bb-translate>{{::item.title}}</div>
        <div ng-if="::!item.complexScope" bb-simple-statistic item="::item"></div>
        <div ng-if="::item.complexScope" bb-complex-statistic item="::item"></div>
      </div>
    </li>
  </ul>
</div>`},559824(e){e.exports=`<td class="table-cell"
