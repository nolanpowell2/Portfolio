         translate-values="{time: $ctrl.selfEnrollGroupInfo.relativeDate}"
         bb-translate>components.directives.group-student-enrollment.enrollment-closes</div>
    <div ng-if="$ctrl.isAfterEnrollment()" class="self-enroll-date"
         bb-translate>components.directives.group-student-enrollment.enrollment-closed</div>
  </div>
</div>
`},479719(e){e.exports=`<!-- this button is for screenreader users only and should be placed at the end of an infinite scroll list in the DOM so that they know that more items can be loaded -->
