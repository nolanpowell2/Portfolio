</span>
`},452037(e){e.exports=`<div class="group-student-self-enroll-directive" bb-load-bundle="components/directives/group/group-student-enrollment">
  <div ng-if="$ctrl.content.assignedGroups.length > 0">
    <span ng-if="!$ctrl.isOpenEnrollment()" class="ellipse title">
      {{$ctrl.content.assignedGroups[0].groupTitle}}
    </span>
    <a ng-if="$ctrl.isSelfEnrollment && $ctrl.isOpenEnrollment()" class="self-enroll-link js-self-enroll-link"
       href="javascript:void(0);" ng-click="$ctrl.openContentEnrollPanel()"
       analytics-id="components.directives.group-student-enrollment.groupTitle.link">
      {{$ctrl.content.assignedGroups[0].groupTitle}}
    </a>
  </div>
  <span ng-if="!($ctrl.content.assignedGroups.length > 0) && !$ctrl.isSelfEnrollment" class="ellipse title" bb-translate
        translate-values="{title: components.directives.group-student-enrollment.unknown}">
    components.directives.group-student-enrollment.unknown
  </span>
  <div ng-if="!($ctrl.content.assignedGroups.length > 0) && $ctrl.isSelfEnrollment">
    <div ng-if="$ctrl.isOpenEnrollment()">
      <a href="javascript:void(0);" ng-click="$ctrl.openContentEnrollPanel()" class="self-enroll-link js-self-enroll-link"
         bb-translate analytics-id="components.directives.group-student-enrollment.self-enroll-to-participate">components.directives.group-student-enrollment.self-enroll-to-participate</a>
