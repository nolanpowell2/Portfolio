  <footer class="panel-footer" ng-if="!(hideCancel() || hideSave() || hideDelete())">
    <!--footer tag is removed, and its children appended to parent if the directive is marked as 'isInline'-->
    <div ng-class="{'inline':isInline(), 'panel-footer-right':!isInline()}" class="buttons-2 equal-buttons">
      <button ng-if="!(hideDelete() != null ? hideDelete() : true)"
              class="button js-delete js-primary-button non-first-focus" ng-class="{'small clear icon':isInline}"
              bb-confirmation-needed="{{ deleteConfirmationResourceType }}"
              show-type="{{mustShowDeleteConfirmation() ? 'always' : 'userChoice'}}"
              ng-disabled="saveButtons.isDeleteDisabled()"
              ng-click="saveButtons.deleteAction()"
              ng-mousedown="saveButtons.mousedownAction()"
              type="button"
              choices="{{choices()}}"
              analytics-id="{{::analyticsIdTagPrefix}}.autosave.saveButtons.delete.button">
                <span ng-if="!isInline()">{{saveButtons.deleteButtonStatus}}</span>
                <span ng-if="isInline()"><i class="icon-trash"></i></span>
      </button>
      <button ng-if="!hideCancel()"
              class="button button--secondary js-cancel js-secondary-button non-first-focus"
              bb-confirmation-needed="{{ saveButtons.isCancelNowADelete() ? deleteConfirmationResourceType : '' }}"
              show-type="{{mustShowDeleteConfirmation() ? 'always' : 'userChoice'}}"
              ng-disabled="saveButtons.isCancelDisabled()"
              ng-click="saveButtons.cancelAction()"
              ng-mousedown="saveButtons.mousedownAction()"
              type="button"
              choices="{{choices}}"
              analytics-id="{{::analyticsIdTagPrefix}}.autosave.saveButtons.cancel.button">{{saveButtons.cancelButtonStatus}}</button>
      <button ng-if="!hideSave()"
              class="button js-save js-primary-button non-first-focus"
              bb-confirmation-needed="{{ saveConfirmationResourceType }}"
              show-type="{{mustShowSaveConfirmation() ? 'always' : 'userChoice'}}"
              ng-disabled="saveButtons.isSaveDisabled()"
              ng-click="saveButtons.saveAction()"
              ng-mousedown="saveButtons.mousedownAction()"
              type="submit"
              analytics-id="{{::analyticsIdTagPrefix}}.autosave.saveButtons.save.button">{{saveButtons.saveButtonStatus}}</button>
    </div>
  </footer>
</div>`},667836(e){e.exports=`<ng-form name="baseForm" bb-autosave save-func="saveForm.save()" validation-func="saveForm.validate()" delay-autosave="delayAutosave()"
         debounce-save-destination="debounceSaveDestination()" novalidate>
    <div ng-transclude />
    <bb-save-buttons validate-save="saveForm.validate()"
                     save-action="saveForm.saveClicked()"
                     cancel-action="saveForm.cancelClicked()"
                     delete-action="saveForm.deleteClicked()"
                     hide-save="hideFooter"
                     hide-cancel="hideFooter"
                     mousedown-action="saveForm.mouseDown()"
                     can-delete="canDelete"
                     display-delete-after-saving="displayDeleteAfterSaving()"
                     delete-confirmation-resource-type="{{deleteConfirmationResourceType}}"
                     must-show-delete-confirmation="true"
                     choices="choices"
                     analytics-id-tag-prefix="{{::analyticsIdTagPrefix}}.saveForm">
    </bb-save-buttons>
</ng-form>
`},894443(e){e.exports=`<div class="element-image avatar no-select" aria-hidden="true"
     ng-class="[avatarsClasses, {'alert-outline': isWarningRender}]"
     bb-load-bundle="components/directives/avatar" bb-cache-compilation="avatar">
  <div class="avatar-inner" ng-if="isAvatarRender && (!autoUpdate || !autoUpdate())">
    <div ng-if="::(!first && !second)" class="first avatar-single">
      <!-- If no user is set -->
      <div class="initials">
        <bb-translate>components.directives.avatar.notAssignedInitials</bb-translate>
      </div>
    </div>

    <div ng-if="::(first && first.avatarUrl)" class="first avatar-single image-avatar">
      <img ng-src="{{::first.avatarUrl}}" bb-image-grayscale="{{::isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.firstAvatarImg : null">
      <!-- If first user is set and has avatar image -->
    </div>

    <div ng-if="::(first && !first.avatarUrl && first.userInitials)"
         class="first avatar-single {{::first.avatarBg}}">
      <!-- If first user is set, but does not have avatar image, but has non-CJK name Will still render default-->
      <img ng-src="{{::first.avatarUrl}}" bb-image-grayscale="{{::isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.firstAvatarImg : null">
    </div>

    <div ng-if="::(first && !first.avatarUrl && !first.userInitials)"
         class="first avatar-single avatar-placeholder">
      <!-- If first user is set, but does not have avatar image and name contains CJK characters -->
      <!-- Show default avatar image -->
      <img ng-if="::(!first.isMultiUser)" src="./static/images/avatar-placeholder.svg" bb-image-grayscale="{{::isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.firstAvatarImg : null">
      <div class="multi-user-id" ng-if="::(first.isMultiUser)">
        <bb-ui-icon-large-users></bb-ui-icon-large-users>
      </div>
    </div>

    <div ng-if="::(second && second.avatarUrl && participants == 2)" class="second avatar-single image-avatar">
      <img ng-src="{{second.avatarUrl}}" bb-image-grayscale="{{::isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.firstAvatarImg : null">
      <!-- If second user is set and has avatar image -->
    </div>

    <div ng-if="::(second && !second.avatarUrl && participants == 2 && second.userInitials)"
         class="second avatar-single {{::second.avatarBg}}">
      <!-- If second user is set, but does not have avatar image, but has non-CJK name. Will still render default -->
      <img ng-src="{{second.avatarUrl}}" bb-image-grayscale="{{::isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.secondAvatarImg : null">
    </div>

    <div ng-if="::(second && !second.avatarUrl && participants == 2 && !second.userInitials)"
         class="second avatar-single avatar-placeholder">
      <!-- If second user is set, but does not have avatar image and name contains CJK characters -->
      <!-- Show default avatar image -->
      <img ng-if="::(!second.isMultiUser)" src="./static/images/avatar-placeholder.svg" bb-image-grayscale="{{::isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.secondAvatarImg : null">
      <div class="multi-user-id" ng-if="::(second.isMultiUser)">
        <bb-ui-icon-large-avatar-multiple></bb-ui-icon-large-avatar-multiple>
      </div>
    </div>

    <div ng-if="participants > 2" class="second avatar-single">
      <!-- If more than 2 participants involved, show \`+3\` type of avatar for right side -->
      <!-- htmlhint:analytics-id:disable -->
      <div class="initials" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.twoPlusAvatar">
        <bb-translate translate-values='{num: participants - 1}' aria-hidden="true">components.directives.avatar.twoPlusInitials</bb-translate>
      </div>
      <!-- htmlhint:analytics-id:enable -->
    </div>
  </div>

  <div class="avatar-inner" ng-if="isAvatarRender && autoUpdate && autoUpdate()">

    <div ng-if="!first && !second" class="first avatar-single">
      <!-- If no user is set -->
      <!-- htmlhint:analytics-id:disable -->
      <div class="initials" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.firstAvatarImg : null">
        <bb-translate>components.directives.avatar.notAssignedInitials</bb-translate>
      </div>
      <!-- htmlhint:analytics-id:enable -->
    </div>

    <div ng-if="first && first.avatarUrl" class="first avatar-single image-avatar">
      <img ng-src="{{first.avatarUrl}}" bb-image-grayscale="{{isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.firstAvatarImg : null">
      <!-- If first user is set and has avatar image -->
    </div>

    <div ng-if="first && !first.avatarUrl && first.userInitials"
         class="first avatar-single {{first.avatarBg}}">
      <!-- If first user is set, but does not have avatar image, but has non-CJK name -->
      <!-- Show default image -->
      <img src="./static/images/avatar-placeholder.svg" bb-image-grayscale="{{isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.firstAvatarImg : null">
    </div>

    <div ng-if="first && !first.avatarUrl && !first.userInitials"
         class="first avatar-single avatar-placeholder">
      <!-- If first user is set, but does not have avatar image and name contains CJK characters -->
      <!-- Show default avatar image -->
      <img ng-if="::(!first.isMultiUser)" src="./static/images/avatar-placeholder.svg" bb-image-grayscale="{{isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.firstAvatarImg : null">
      <div class="multi-user-id" ng-if="::(first.isMultiUser)">
        <bb-ui-icon-large-avatar-multiple></bb-ui-icon-large-avatar-multiple>
      </div>
    </div>

    <div ng-if="second && second.avatarUrl && participants == 2" class="second avatar-single image-avatar">
      <img ng-src="{{second.avatarUrl}}" bb-image-grayscale="{{isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.secondAvatarImg : null">
      <!-- If second user is set and has avatar image -->
    </div>

    <div ng-if="second && !second.avatarUrl && participants == 2 && second.userInitials"
         class="second avatar-single {{second.avatarBg}}">
      <!-- If second user is set, but does not have avatar image, but has non-CJK name -->
      <!-- Show default image -->
      <img src="./static/images/avatar-placeholder.svg" bb-image-grayscale="{{isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.secondAvatarImg : null">
    </div>

    <div ng-if="second && !second.avatarUrl && participants == 2 && !second.userInitials"
         class="second avatar-single avatar-placeholder">
      <!-- If second user is set, but does not have avatar image and name contains CJK characters -->
      <!-- Show default avatar image -->
      <img ng-if="::(!second.isMultiUser)" src="./static/images/avatar-placeholder.svg"  bb-image-grayscale="{{isGray()}}" alt="" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.secondAvatarImg : null">
      <div class="multi-user-id" ng-if="::(second.isMultiUser)">
        <bb-ui-icon-large-avatar-multiple></bb-ui-icon-large-avatar-multiple>
      </div>
    </div>

    <div ng-if="participants > 2" class="second avatar-single">
      <!-- If more than 2 participants involved, show \`+3\` type of avatar for right side -->
      <!-- htmlhint:analytics-id:disable -->
      <div class="initials" analytics-id="analyticsIdTagPrefix ? {{::analyticsIdTagPrefix}}.twoPlusAvatar : null">
        <bb-translate translate-values='{num: participants - 1}' aria-hidden="true">components.directives.avatar.twoPlusInitials</bb-translate>
      </div>
      <!-- htmlhint:analytics-id:enable -->
    </div>
  </div>
</div>
`},953643(e){e.exports=`<div ng-switch="$ctrl.icon">
