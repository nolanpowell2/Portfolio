  </div>
  <div ng-mousedown="gradeGridOverallEditorReborn.mousedown()" ng-class="{hidden: gradeGridOverallEditorReborn.isHiddenPointsPossible}">
    <span class="slash"></span><span class="possible" ng-bind="gradeGridColumnOverallReborn.pointsPossibleToDisplay"></span>
  </div>
</div>
<bb-complete-incomplete-grade-pill
  class="js-completeScore"
  ng-keydown="gradeGridOverallEditorReborn.onKeydown($event)"
  ng-if="gradeGridOverallEditorReborn.isSchemaTypeComplete()"
  grade-value="gradeGridOverallEditorReborn.score"
  is-complete="gradeGridOverallEditorReborn.isStatusComplete()"
  on-blur="gradeGridOverallEditorReborn.onCompleteIncompleteBlur"
  analytics-id="components.directives.grade.grid.overAll.input.text"
  total-points="gradeGridOverallEditorReborn.scope.gradeGridColumnOverallReborn.pointsPossible"
  initial-has-focus="true"
></bb-complete-incomplete-grade-pill>
`},884755(e){e.exports=`<div class="spinner bb-secondary-color-2" ng-if="!gg.initialized" aria-hidden="true"></div>
<div id="grade-grid-container" class="grade-grid-container" ng-class="{'membership-loading': !gg.initialized}">
