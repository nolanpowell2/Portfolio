    <span class="progress-indicator"><div class="canvas" ng-class="{'success-state' : saveTray.status === 'success', 'error-state' : saveTray.status === 'error'}"></div></span>
    <span class="progress-status" ng-switch-default bb-translate>{{::saveTray.localizationKeysPrefix}}.saving</span>
    <span class="progress-status" ng-switch-when="success" bb-translate>{{::saveTray.localizationKeysPrefix}}.success</span>
    <span class="progress-status" ng-switch-when="error" bb-translate>{{::saveTray.localizationKeysPrefix}}.error</span>
  </div>
</div>
