      <bb-svg-icon class="catalog-icon-large-breakpoint" size="medium" icon="programs" />
    </span>
    <bb-svg-icon class="catalog-icon-small-breakpoint" size="small" icon="course_catalog_default" ng-if="!windowSizeService.isLargeBreakpoint()" />
  </a>
