</th>`},141975(e){e.exports=`<table class="fs-table bb-table">
  <caption role="alert" class="sr-only">{{ ::config().title }}</caption>
  <thead>
    <tr class="table-headings">
      <th class="table-heading"
          scope="col"
          ng-style="{ 'width': column.widthPercentage, 'min-width': column.widthPercentage }"
          ng-repeat="column in config().columns"
          ng-if="column.visible"
          data-heading-index="{{ ::$index }}"
          ng-class="{
            'sortable-header': column.sort,
            'ascending': $index === config().currentSortColumnIndex && config().currentSortDirection === 'asc',
            'descending': $index === config().currentSortColumnIndex && config().currentSortDirection === 'desc'}"
          ng-attr-aria-sort="{{ $index === config().currentSortColumnIndex && config().currentSortDirection === 'asc' ? 'ascending' :
          $index === config().currentSortColumnIndex && config().currentSortDirection === 'desc' ? 'descending' : undefined }}">
        <button class="button-anchor" ng-if="column.sort" analytics-id="components.directives.table.sort.button">
          <span class="table-heading-contents" ng-class="{ 'sr-only': column.srHeading }">{{ column.heading }}</span>
          <i class="sort-control">
            <i class="arrow up" ></i>
            <i class="arrow down"></i>
          </i>
        </button>
        <span ng-if="!column.sort" class="table-heading-contents" ng-class="{ 'sr-only': column.srHeading }">{{ column.heading }}</span>
      </th>
    </tr>
  </thead>
  <tbody ng-if="table.initialDataLoaded || config().showRowsDuringRefresh">
    <tr ng-repeat="item in tableData()"
        class="table-row"
        ng-class="{'clickable': config().rowClickFn }"
        ng-click="config().rowClickFn ? config().rowClickFn(item): null"
        ng-transclude
        analytics-id="components.directives.table.rowClick"></tr>
  </tbody>
</table>
<div ng-if="config().pageSize && table.initialDataLoaded">
  <div bb-infinite-scroll="table.showMore()"
       infinite-scroll-immediate-check="false"
       infinite-scroll-total-count="config().totalCount"
       infinite-scroll-current-count="tableData().length"
       infinite-scroll-load-limit="config().pageSize"
       infinite-scroll-container="config().infiniteScrollContainerSelector()"
       infinite-scroll-tray-id="{{::config().instanceId}}-scroll-tray"></div>
</div>
<div class="spinner bb-secondary-color-2" ng-show="!table.initialDataLoaded"></div>`},27971(e){e.exports=`<div class="telemetry-panel">

  <div id="discussion-insights" class="panel-content discussion-insights" bb-foundation-defer>

    <div class="insights">
      <div class="insight-summary row collapse summary-box">
        <div class="column small-12">
          <bb-statistics
            config="statisticsConfig"
            ng-if="isLoaded"
            small-per-row="1"
            large-per-row="4"></bb-statistics>
        </div>
      </div>

      <div class="participation-chart-container">
        <div class="bar-chart">
          <span class="participated"
                aria-label="{{barchartParticipants}}"
                title="{{barchartParticipants}}"></span>
          <span class="opened"
                aria-label="{{barchartOpenedNonParticipants}}"
                title="{{barchartOpenedNonParticipants}}"></span>
          <span class="unopened"
                aria-label="{{barchartNonParticipants}}"
                title="{{barchartNonParticipants}}"></span>
        </div>
        <div class="legend">
          <div class="participatedCaption" data-ng-bind-html="discussionInsights.getSafeHtml(percentParticipatedCaption)"></div>
          <div class="openedCaption" data-ng-bind-html="discussionInsights.getSafeHtml(percentOpenedCaption)"></div>
        </div>
      </div>

      <div class="non-participant-groups row" ng-if="displayNonParticipantGroups">
        <div class="column small-12 non-participant-box clearfix" bb-foundation-defer>
          <h3 class="stat-title large-non-participants-title"
              bb-translate="components.directives.discussion.insights.groupNonParticipants"
              translate-values="{count: totalNonParticipants}"></h3>
          <div class="float-right" ng-if="::canCreateMessage">
            <button class="button super-clear message-all-non-participants-button"
                type="button"
                ng-click="discussionInsights.goToMessageAll()"
                bb-translate-attrs="{'aria-label': 'components.directives.discussion.insights.messageNonParticipants'}"
                translate-attrs-values="{count: totalNonParticipants}"
                analytics-id="components.directives.discussion.insights.messageNonParticipants.button">
              <bb-ui-icon-medium-messages></bb-ui-icon-medium-messages>
            </button>
          </div>

          <div class="group-nonparticipants" ng-repeat="nonParticipantGroup in nonParticipantGroups track by nonParticipantGroup.id">
            <div class="group-heading child-is-invokable" bb-click-to-invoke-child="a.group-link">
              <a class="group-link"
                 href="javascript:void(0);"
                 ng-click="discussionInsights.goToDiscussion(nonParticipantGroup.id)"
                 analytics-id="components.directives.discussion.insights.nonParticipantGroup.link">
                {{nonParticipantGroup.name}}
              </a>
            </div>
            <div class="nonparticipant-in-group-container"
                 ng-class="nonParticipantGroup.total > 3 ? 'space-evenly' : 'set-margin' ">
              <div class="nonparticipant-in-group child-is-invokable"
                 bb-click-to-invoke-child="a.group-non-participant-link"
                 ng-repeat="nonParticipant in nonParticipantGroup.nonParticipants | limitTo: 4 track by nonParticipant.id">
              <bb-avatar class="nonparticipant-in-group-avatar" user="nonParticipant"></bb-avatar>
              <a ng-if="canCreateMessage"
                 class="group-non-participant-link"
                 href="javascript:void(0);"
                 aria-label="{{nonParticipant.localizedName}}"
                 ng-click="discussionInsights.goToMessage(nonParticipant.id)"
                 analytics-id="components.directives.discussion.insights.nonParticipant.link">
                {{nonParticipant.localizedName}}
              </a>
              <!-- Show only the name (not clickable to handle AX issue) if user doesn't have permission -->
               <span ng-if="!canCreateMessage">{{nonParticipant.localizedName}}</span>
            </div>
            </div>
            <div class="count-link">
              <a ng-click="discussionInsights.goToDiscussion(nonParticipantGroup.id)"
                 ng-show="nonParticipantGroup.hidden > 0"
                 href="javascript:void(0);"
                 bb-translate="components.directives.discussion.insights.moreLink"
                 translate-values="{count: nonParticipantGroup.hidden}"
                 analytics-id="components.directives.discussion.insights.moreLink">
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="non-participants row" ng-show="(displayNonParticipants || displayNonParticipantGroup)">
        <div class="column small-12 non-participant-box clearfix" ng-if="showLargeNonparticipantPanel" bb-foundation-defer>
          <h3 class="stat-title large-non-participants-title" bb-translate="components.directives.discussion.insights.nonParticipants"></h3>
          <div class="float-right">
            <button class="button super-clear message-all-non-participants-button"
                type="button"
                ng-if="discussionInsights.canMessageNonParticipants()"
                ng-click="discussionInsights.goToMessageAll()"
                bb-translate-attrs="{'aria-label': 'components.directives.discussion.insights.messageNonParticipants'}"
                translate-attrs-values="{count: totalNonParticipants}"
                analytics-id="components.directives.discussion.insights.messageNonParticipants.button">
              <bb-ui-icon-medium-messages></bb-ui-icon-medium-messages>
            </button>
          </div>
          <ul class="non-participant-list clearfix" ng-show="!discussionInsights.isAnonymousDiscussionEnabled">
            <li class="non-participant child-is-invokable"
                bb-click-to-invoke-child="a.non-participant-link"
                tabindex="-1"
                ng-show="showNonparticipant[$index]"
                ng-repeat="nonParticipant in nonParticipants | limitTo: 18 track by nonParticipant.id">
              <div class="non-participant-cell"
                   ng-class="{'show-focus-outline': discussionInsights.isFocusedNonparticipant(nonParticipant.id)}">
                <a ng-if="canCreateMessage"
                   class="non-participant-link hide-focus-outline"
                   bb-translate-attrs="{'aria-label': nonParticipant.localizedNameWithoutWrap}"
                   id="non-participant-link-{{nonParticipant.id}}"
                   tabindex="0"
                   href="javascript:void(0);"
                   ng-focus="true"
                   ng-blur="true"
                   ng-click="discussionInsights.goToMessage(nonParticipant.id)"
                   analytics-id="components.directives.discussion.insights.nonParticipantLink.link">
                  <bb-avatar class="non-participant-avatar" user="nonParticipant.avatarData"></bb-avatar>
                </a>
                <!-- Display only the avatar for users who lack message creation permissions.This visually differentiates non-participants and prevents interaction with the messaging feature. -->
                <bb-avatar ng-if="!canCreateMessage" class="non-participant-avatar" user="nonParticipant.avatarData"></bb-avatar>
                <span ng-if="!discussionInsights.isPreferedNameBoth(nonParticipant)" class="byline stacked" ng-bind-html="discussionInsights.getSafeHtml(nonParticipant.localizedName)"></span>

                <div ng-if="discussionInsights.isPreferedNameBoth(nonParticipant)">
                  <span class="byline stacked stacked-other-name" ng-bind-html="discussionInsights.getSafeHtml(nonParticipant.otherName)"></span>
                  <span class="byline stacked stacked-other-name" ng-bind-html="discussionInsights.getSafeHtml(nonParticipant.fullName)"></span>
                </div>
              </div>
            </li>
          </ul>
          <label class="{{discussionInsights.isAnonymousDiscussionEnabled ? 'anonymous-participants' : 'summary-line'}}">
            {{discussionInsights.isAnonymousDiscussionEnabled ? anonymousNonParticipations : nonParticipationSummary}}
          </label>
        </div>
        <div class="column small-12 non-participant-box clearfix" ng-if="!showLargeNonparticipantPanel">
          <h3 class="stat-title subheader">{{barchartNonParticipants}}</h3>
          <button class="messageAllButton button"
                  bb-translate="components.directives.discussion.insights.messageAll"
                  bb-translate-attrs="{'aria-label': 'components.directives.discussion.insights.messageAll'}"
                  ng-click="discussionInsights.goToMessageAll()"
                  analytics-id="components.directives.discussion.insights.messageAll">
          </button>
        </div>
      </div>

      <div class="row equal-height" ng-if="displayTopComments || displayTopParticipants">
        <div class="top-comments column {{topCommentsColumns}} student-list-box" ng-if="displayTopComments">
          <h3 class="stat-title subheader"
              id="most-replies-heading"
              bb-translate="components.directives.discussion.insights.mostReplies"></h3>
          <div class="tabular-list-container">
            <div class="tabular-row top-comment-row child-is-invokable"
                 bb-click-to-invoke-child="a.discussion-link"
                 ng-class="{'last':$last}"
                 ng-repeat="comment in topComments | limitTo: numberOfCommentsToDisplay | orderBy: '-numReplies'">
              <a href="javascript:void(0);"
                 class="discussion-link"
                 ng-click="discussionInsights.goToDiscussion(comment.messageId, comment.user.group.id)"
                 aria-labelledby="comment-user-{{comment.user.id}} most-replies-heading"
                 aria-describedby="comment-message-{{comment.user.id}}
                 comment-replies-{{comment.user.id}}"
                 analytics-id="components.directives.discussion.insights.goToDiscussion.link">
                <bb-avatar class="top-participant-avatar" user="comment.user.avatarData"></bb-avatar>
                <div class="comment-info">
                  <div class="comment-message ellipsis" id="comment-message-{{comment.user.id}}">{{comment.message}}</div>
                  <div class="byline ellipsis">
                    <span id="comment-user-{{comment.user.id}}">
                      <bb-translate>components.directives.discussion.insights.by</bb-translate> {{comment.user.localizedName}}
                      <span ng-show="isGroupDiscussion"><bb-translate>components.directives.discussion.insights.inGroup</bb-translate> {{comment.user.group.name}}</span>
                    </span> |
                    <span id="comment-replies-{{comment.user.id}}"> {{comment.numReplies}} <bb-translate>components.directives.discussion.insights.replies</bb-translate></span>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
        <div class="top-participants column {{topParticipantColumns}} student-list-box" ng-if="displayTopParticipants || discussionInsights.isAnonymousDiscussionEnabled">
          <h3 id="top-heading" class="stat-title subheader" bb-translate="components.directives.discussion.insights.topParticipants"></h3>
          <div class="tabular-list-container" ng-show="!discussionInsights.isAnonymousDiscussionEnabled">
            <div class="tabular-row top-participants-row child-is-invokable"
                 bb-click-to-invoke-child="a.grading-panel-link"
                 ng-class="{'last':$last, 'not-graded': (!isGradable || isGroupDiscussion), 'group-row':isGroupDiscussion}"
                 ng-repeat="participant in topParticipants | limitTo: numberOfCommentsToDisplay | orderBy: '-numComments'">
              <a href="javascript:void(0);"
                 class="grading-panel-link"
                 aria-labelledby="user-{{participant.user.id}} top-heading"
                 aria-describedby="span-replies-{{participant.user.id}} span-feedback-{{participant.user.id}}"
                 ng-class="{'not-graded': (!isGradable || isGroupDiscussion)}"
                 ng-click="discussionInsights.goToGrade(participant.user.id)"
                 analytics-id="components.directives.discussion.insights.goToGrade.link">
                <bb-avatar class="comment-avatar" user="participant.user.avatarData"></bb-avatar>
                <div class="top-participant-info ellipsis" ng-class="{'not-graded': !isGradable}">
                  <span class="discussion-insights-heading" id="user-{{participant.user.id}}">{{participant.user.localizedName}}</span><br>
                  <span class="ellipsis" ng-show="isGroupDiscussion">{{participant.user.group.name}}</span><br ng-show="isGroupDiscussion">
                  <span class="byline" id="span-feedback-{{participant.user.id}}">
                    <bb-svg-icon class="top-participant-icon" size="small" icon="feedback" bb-translate-attrs="{'aria-label': 'components.directives.discussion.insights.feedback'}"></bb-svg-icon>
                    {{participant.numComments}}
                  </span>
                  <span class="byline" id="span-replies-{{participant.user.id}}">
                  <bb-svg-icon class="top-participant-icon" size="small" icon="replies" bb-translate-attrs="{'aria-label': 'components.directives.discussion.insights.replies'}"></bb-svg-icon>
                    {{participant.numReplies}}
                  </span>
                </div>
              </a>
            </div>
          </div>
          <label class="anonymous-participants" ng-show="discussionInsights.isAnonymousDiscussionEnabled" bb-translate>components.directives.discussion.insights.anonymousParticipant</label>
        </div>
      </div>
    </div>
    <div ui-view="telemetry-discussion-forum-insights-base@"></div>
  </div>
</div>
`},887835(e){e.exports=`<div>
  <!-- Display a loading spinner if page is rendering -->
  <div class="telemetry-loading-anim" ng-if="telemetryPanelHeader.showSpinner">
    <div class="spinner bb-secondary-color-2"/>
  </div>
  <header class="panel-header simple-header">
    <div class="panel-titles-container">
      <div class="panel-sub-title">{{ ::course().name }}</div>
      <div class="black-header-contents">
        <button class="menu-toggle standard-button dark-background"
                menu-toggle-click
                type="button"
                analytics-id="components.directives.telemetry.panel.menu.button">
          <bb-svg-icon size="small" icon="main-menu"></bb-svg-icon>
          <span class="sr-only" bb-translate>components.directives.telemetry.panel.menu</span>
        </button>
        <h1 class="panel-title" ng-if="::titleKey" bb-translate>{{::titleKey}}</h1>
        <h1 class="panel-title" ng-if="title">{{::title}}</h1>
        <!-- BUTTON 2 (displayed to the left of Button 1) -->
        <button ng-if="buttonTwoIcon" id="button-two"
                aria-haspopup="true"
                class="standard-button dark-background hide-for-large-up"
                bb-translate-attrs="{'aria-label': buttonTwoAriaLabel,'title': buttonTwoTitle}"
                ng-click="buttonTwoCallback()"
                ng-class="{ 'active': mobileStudentListVisible }"
                analytics-id="components.directives.telemetry.panel.buttonwTwo.button">
          <i class="{{ ::buttonTwoIcon }}"></i>
          <span class="sr-only" bb-translate>buttonTwoTitle</span>
        </button>
        <!-- BUTTON 1 (displayed on the far right) -->
        <button ng-if="buttonOneIcon"
                id="button-one"
                class="standard-button dark-background hide-for-large-up"
                bb-translate-attrs="{'aria-label': buttonOneAriaLabel,'title': buttonOneTitle}"
                ng-click="buttonOneCallback()"
                analytics-id="components.directives.telemetry.panel.buttonOne.button">
          <i class="{{ ::buttonOneIcon }}"></i>
          <span class="sr-only" bb-translate>buttonOneTitle</span>
        </button>
      </div>
    </div>
  </header>
</div>
`},111089(e){e.exports='<style type="text/css"></style>'},487581(e){e.exports=`<div class="typeahead-search js-typeahead-search" bb-click-outside="typeaheadSearchBox.onClickOutside()" is-active="true" bb-load-bundle="components/directives/typeahead">
  <label for="typeahead-search-box-{{::typeaheadSearchBox.randomElementId}}">
    <bb-svg-icon ng-if="::typeaheadSearchBox.icon" icon="{{::typeaheadSearchBox.icon}}" size="small" class="magnifying-glass"></bb-svg-icon>
    <span ng-if="::typeaheadSearchBox.srLabel" class="sr-only" bb-translate="{{::typeaheadSearchBox.srLabel}}"></span>
  </label>
  <input aria-describedby="requiredPrompt" type="text" id="typeahead-search-box-{{::typeaheadSearchBox.randomElementId}}"
         ng-model="typeaheadSearchBox.searchValue"
         ng-model-options="{ debounce: 250 }"
         role="combobox"
         aria-activedescendant="typeahead-result-{{::typeaheadSearchBox.randomElementId}}-0"
         aria-autocomplete="list"
         aria-owns="typeahead-search-autocomplete"
         name="typeaheadSearchBox"
         autocomplete="off"
         ng-keydown="typeaheadSearchBox.onInputBoxKeyDown($event)"
         ng-click="typeaheadSearchBox.onInputBoxClick($event)"
         ng-change="typeaheadSearchBox.onSearchValueChange()"
         ng-focus="typeaheadSearchBox.onFocusInputBox($event)"
         bb-translate-attrs="{'placeholder': '{{typeaheadSearchBox.inputPlaceholder}}'}"
         class="truncated"
         ng-class="{'not-empty with-clear-btn': typeaheadSearchBox.searchValue, 'empty': !typeaheadSearchBox.searchValue,
                    'with-icon': typeaheadSearchBox.icon, 'is-active': typeaheadSearchBox.isFocus}"
         analytics-id="components.directives.typeheadSearchBox.input.text"/>
    <button class="typeahead-clear-button" bb-translate-attrs="{'aria-label': '{{typeaheadSearchBox.clearAriaLabel}}'}"
            tabindex="0"
            ng-show="typeaheadSearchBox.searchValue"
            ng-click="typeaheadSearchBox.clear()"
            ng-focus="typeaheadSearchBox.onFocusClearBtn($event)"
            ng-blur="typeaheadSearchBox.onBlurClearBtn($event)"
            analytics-id="components.directives.typeheadSearchBox.clearAriaLabel.button">
      <bb-svg-icon size="small" icon="close"></bb-svg-icon>
    </button>
  <span id="requiredPrompt" class="sr-only" bb-translate="{{::typeaheadSearchBox.srEmptyResults}}"></span>
  <div id="typeahead-search-autocomplete" class="typeahead-search-autocomplete adding"
       ng-if="typeaheadSearchBox.showResults"
       role="listbox"
       tabindex="-1">
    <div class="typeahead-search-entry js-typeahead-search-entry" ng-repeat="item in typeaheadSearchBox.searchResults"
         role="option"
         tabindex="-1"
         id="typeahead-result-{{::typeaheadSearchBox.randomElementId}}-{{$index}}"
         ng-keydown="typeaheadSearchBox.onResultEntryKeyDown($event, item)"
         ng-click="typeaheadSearchBox.onResultEntryClick($event, item)"
         analytics-id="components.directives.typeheadSearchBox.onResultEntryClick">
      <typeahead-inject></typeahead-inject>
    </div>
  </div>
</div>
`},373763(e){e.exports=`<div>
