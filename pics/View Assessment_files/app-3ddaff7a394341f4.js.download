    bb-translate-attrs="{'aria-label': '{{attrTranslateKey}}'}"
    ng-disabled="savingInProgress"
    class="{{extraClass}}" role="button"
    analytics-id="components.directives.delete.deleteElement.link" 
  >
    <span class="valign">
      <span class="valign-content">
        <bb-svg-icon size="small" icon="trash" class="icon-fw replaced"></bb-svg-icon>
        <span class="ellipse" bb-translate="components.directives.delete.control-delete-label"></span>
      </span>
    </span>
  </a>
  <button ng-if="delete.requiredArgumentsSupplied"
          bb-confirmation-needed get-confirmation-key-and-show-type="delete.getConfirmationKeyAndShowType()"
          choices="{{choices}}"
          ng-click="delete.deleteElement()"
          ng-disabled="delete.isDeleteDisabled"
          bb-translate-attrs="{'aria-label': '{{attrTranslateKey}}', 'title': '{{attrTranslateKey}}'}"
          ng-switch-default
          class="button clear icon {{extraClass}}" type="button"
          analytics-id="components.directives.delete.deleteElement.button"
  >
    <bb-svg-icon size="small" icon="trash"></bb-svg-icon>
  </button>
</ng-switch>`},589524(e){e.exports=`<bb-modal class="notification"
          modal-title-key="components.directives.cloudStorageIntegration.modal.authorizationRequiredTitle"
          analytics-id-tag-prefix="components.directives.cloudStorageIntegration.authorizationRequired">
  <div name="modal-contents">
