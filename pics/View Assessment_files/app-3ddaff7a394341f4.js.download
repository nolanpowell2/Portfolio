`},636279(e){e.exports=`<div class="grade-input-wrapper" ng-class="{'has-validation-error': !!gradeInput.form[gradeInput.id].$invalid}">
  <div ng-show="!gradeInput.isSchemaTypeComplete()" class="grade-pill-container" ng-attr-id="{{hasRubricClearConfirmationCallout ? 'grade-input-container-callout' : ''}}">
    <div>
      <bb-inline-validation
        show-error="!!gradeInput.form[gradeInput.id].$invalid"
        bb-translate-attrs="{ 'error-message': errorMessageKey }"
        ng-show="gradeInput.shouldShowInput()">
        <div
          ng-class="{'not-graded-exempt': !gradeInput.colorClass && gradeDetail.isExempt, 'show-total': gradeInput.shouldShowTotalPoints(), 'is-multiple': gradeInput.isMultipleShown() && !gradeDetail.isExempt,
                      'is-in-progress': gradeInput.isInProgressShown() && !gradeDetail.isExempt, 'group-grade-input': !!forGroup, 'disable-click': !individualAttemptIndicator && gradeDetail.isExempt && !editGradeWhenExemptWithParticipation }"
          class="wrapping-input-style {{gradeInput.colorClass}}" data-dropdown="performanceCodes-{{gradeInput.id}}">
          <div bb-foundation-defer>
            <div class="wrapping-editable-input">
              <!-- Discussion assoicated with any rubric should include an input field for entering a grade and an rubric icon with anchor tag to open the rubric panel -->
              <a ng-if="gradeInput.isRubricEvalMode() && column.isDiscussion()" ng-click="gradeInput.openRubricEvaluation()"
                aria-disabled="{{disableRubricEvalClick()}}" href="javascript:void(0);"
                class="js-anchor-tag"
                analytics-id="directives.grade-input.rubric.evaluation.link">
                <bb-svg-icon size="small" icon="rubric"></bb-svg-icon>
              </a>

              <bb-svg-icon size="small" icon="rubric" ng-if="!column.isDiscussion() && !gradeInput.isNoScoreRubric() && gradeInput.isRubricEvalMode() && gradeInput.shouldShowInput()"
                       ></bb-svg-icon>


              <input name="{{gradeInput.id}}" autocomplete="off"
                     ng-class="{'group-multiple': gradeInput.isMultipleShown(), 'group-in-progress': gradeInput.isInProgressShown()}"
                     pu-elastic-input pu-elastic-input-minwidth="10px" pu-elastic-input-maxwidth="180px"
                     pu-elastic-input-width-delta="8"
                     type="text" placeholder="--"
                     bb-translate-attrs="{ 'aria-label': gradeInput.getGradeInputAriaLabelKey() }"
                     translate-attrs-values="{ user: forUser, group_name: forGroup && forGroup.title, grade: gradeInput.gradeDisplayItem.displayValue, total: gradeDetail.pointsPossible || (column.isCalculated() ? 100 : column.possible)}"
                     ng-model="gradeInput.gradeDisplayItem.displayValue" ng-readonly="gradeInput.isReadOnly()"
                     title="{{gradeInput.gradeDisplayItem.perfCodeDesc}}"
                     ng-blur="gradeInput.onBlur($event)" ng-change="gradeInput.gradeValueOnChange()"
                     ng-focus="gradeInput.onFocus()"
                     class="js-grade-input" analytics-id="directives.grade-input.grade.display.item.input"
                     aria-invalid="{{!!gradeInput.form[gradeInput.id].$invalid ? 'true' : 'false'}}"
                     ng-attr-aria-describedby="{{ gradeInput.fetchAriaDescribeById()}}">

              <bb-confirmation-callout-dialog
                ng-if="hasRubricClearConfirmationCallout"
                analytics-id="directives.grade-input.grade.clearRubricConfirmation"
                target="'#grade-input-container-callout'"
                is-visible="gradeInput.gradeDialog.isVisible"
                text-content="gradeInput.gradeDialog.textContent"
                on-dismiss="gradeInput.gradeDialog.onDismiss"
                on-success="gradeInput.gradeDialog.onSuccess"
              >
              </bb-confirmation-callout-dialog>
            </div>

          </div>

          <!--TOTAL POINTS-->
          <!-- Fix ULTRA-15280.
          If there is gradeDetail, we should use its pointsPossible as the total.
          If there is no gradeDetail, which means it is not graded yet, there are tow cases:
           for overall grade (and calculations), we use the default value 100, unless the overall grade schema is ScoreBased
           for common column, assignment, etc. we use column.possible. -->
          <span ng-if="gradeInput.shouldShowTotalPoints()" class="points-text" bb-translate
                translate-values="{total: gradeInput.getTruncatedPointsPossible()}">
        components.directives.grade.grade-input.points
        </span>
        </div>
        <div class="alert-icon" ng-if="!!gradeInput.form[gradeInput.id].$invalid">
          <bb-svg-icon size="small" icon="attention" status="alert"></bb-svg-icon>
        </div>
      </bb-inline-validation>
      <a ng-show="!gradeInput.shouldShowInput()" class="button super-clear has-rubric wrapping-input-style {{gradeInput.colorClass}}"
         ng-class="{'show-total': gradeInput.shouldShowTotalPoints(), 'is-multiple': gradeInput.isMultipleShown(), 'is-in-progress': gradeInput.isInProgressShown(), 'group-grade-input': !!forGroup, 'disable-click': disableRubricEvalClick()}"
         ng-click="gradeInput.openRubricEvaluation()"
         aria-disabled="{{disableRubricEvalClick()}}"
         href="javascript:void(0);" analytics-id="directives.grade-input.rubric.evaluation.link">
        <span class="sr-only" bb-translate translate-values="{user: forUser}">components.directives.grade.grade-input.rubricButtonAlt</span>
        <bb-svg-icon size="small" icon="rubric"></bb-svg-icon>
        <span name="{{gradeInput.id}}" class="grade-point-value"
              ng-class="{'group-multiple': gradeInput.isMultipleShown(), 'group-in-progress': gradeInput.isInProgressShown()}">
        {{gradeInput.gradeDisplayItem.displayValue || '--'}}&nbsp;
      </span>

        <!--TOTAL POINTS-->
        <span ng-if="gradeInput.shouldShowTotalPoints()" class="points-text" bb-translate
              translate-values="{total: gradeDetail.pointsPossible || (column.isCalculated() ? 100 : column.possible)}">
        components.directives.grade.grade-input.points
      </span>
      </a>
    </div>
  </div>

  <bb-complete-incomplete-grade-pill
    class="js-complete-pill"
    ng-if="gradeInput.isSchemaTypeComplete()"
    ng-model="gradeInput.gradeDisplayItem.displayValue"
    name="{{gradeInput.id}}"
    aria-complete-incomplete-label="gradeInput.getAriaLabel()"
    analytics-id="directives.grade-input.grade.display.item.input"
    grade-value="gradeInput.gradeDisplayItem.userEnteredValue"
    is-complete="gradeInput.isStatusComplete()"
    on-blur="gradeInput.onCompleteIncompleteBlur"
    total-points="gradeInput.getTruncatedPointsPossible()"
    is-editable="gradeInput.shouldEditCompleteIncompletePill()"
    is-rubric-enabled="gradeInput.isRubricEvalMode()"
    can-open-rubric-eval="gradeInput.openRubricEvaluation"
    is-exempt="gradeInput.shouldShowExempt()"
    >
  </bb-complete-incomplete-grade-pill>
  <div ng-if="gradeInput.shouldShowExempt()" class="grade-input-align left">
    <span class="override-indicator" bb-translate>components.directives.grade.grade-input.exempt</span>
  </div>

  <div ng-if="gradeInput.shouldShowOverrideIndicator()" class="left">
    <span class="override-indicator" bb-translate>components.directives.grade.grade-input.overrideIndicator</span>
  </div>

  <div ng-if="gradeInput.shouldShowPastDueZeroIndicator()"
       ng-class="{'grade-input-align left': gradeInput.shouldShowPastDueZeroIndicator(), 'left': !gradeInput.shouldShowPastDueZeroIndicator()}">
    <span class="override-indicator" bb-translate>components.directives.grade.grade-input.pastDueZero</span>
  </div>

  <div ng-if="gradeInput.alertScreenReaderNewGrade"
       bb-ax-alert
       ng-attr-id="{{gradeInput.fetchAriaDescribeById()}}"
       class="sr-only"
       bb-translate translate-values="{grade: gradeInput.gradeDisplayItem.displayValue}">
    components.directives.grade.grade-input.screenReaderEnteredGrade
  </div>
</div>
<clear-grade-model show-dialog="gradeInput.openDirectGradeClearModel"
  on-close-dialog="gradeInput.closeClearGradePopup"
  on-confirm-clear-grade="gradeInput.confirmClearGradePopup"
  analytics-id="components.directives.grade.input.directGradeClearModel"
/>
`},27339(e){e.exports=`<ul role="listbox" id="performanceCodes-{{gradeInput.id}}" class="f-dropdown performance-code-options bb-foundation-dropdown-close-esc-override" data-dropdown-content>
  <li class="performance-option-header" bb-translate>components.directives.grade.grade-input.selectPerformanceCode</li>
  <li  role="option" ng-repeat="perfCode in gradeNotations()" bb-click-to-invoke-child="a.performance-code-option">
    <a href="javascript:void(0);"
       ng-click="gradeInput.clickGradeNotation(perfCode,$event)"
       class="performance-code-option"
       analytics-id="directives.gradeInput.selectPerformanceCode.item.link"
       aria-label="{{perfCode.code}} {{perfCode.description}}">
      <span class="code" title="{{perfCode.code}}">{{perfCode.code}}</span>
      <span class="description" title="{{perfCode.description}}">{{perfCode.description}}</span>
    </a>
  </li>
  <li role="option" ng-if="gradeDetail.displayGrade.isOverride" class="undo-override" bb-click-to-invoke-child="button.js-undo-override">
    <a href="javascript:void(0);"
       class="js-undo-override performance-code-option"
       ng-click="gradeInput.undoOverride()"
       aria-label="{{gradeInput.ariaLabelContent}}"
       analytics-id="directives.grade-input.undoOverride.link">
      <bb-svg-icon size="small" icon="undo"></bb-svg-icon>
      <span bb-translate>components.directives.grade.grade-input.undoOverride</span>
    </a>
  </li>
</ul>

`},20960(e){e.exports=`<bb-modal id="dialog-override-warning-modal" class="notification dialog-override-warning-modal"
         modal-title-key="components.directives.grade.grade-input.overrideDialogWarning.title"
         analytics-id-tag-prefix="components.directives.grade.grade-input.overrideDialogWarning"
         >
  <div name="modal-contents">
    <p class="warning-message" bb-translate="components.directives.grade.grade-input.overrideDialogWarning.message" translate-values="{grade}">
    </p>
  </div>
  <button name="modal-footer-button-secondary" class="button button--secondary js-secondary-button js-cancel" ng-click="closeModal(false)" analytics-id="components.directives.grade.grade-input.overrideDialogWarning.secondaryButtonText">
      <bb-translate>components.directives.grade.grade-input.overrideDialogWarning.secondaryButtonText</bb-translate>
  </button>
  <button name="modal-footer-button-primary" class="button js-primary-button" ng-click="closeModal(true)" analytics-id="components.directives.grade.grade-input.overrideDialogWarning.primaryButtonText">
      <bb-translate>components.directives.grade.grade-input.overrideDialogWarning.primaryButtonText</bb-translate>
  </button>
</bb-modal>
`},442543(e){e.exports=`<td role="cell" aria-describedby="gradable-item-header-title" aria-colindex="1" tabindex="-1"
class="tabular-cell grader-column item-inline-size">
  <div class="element-card"
    ng-class="{'is-restricted': graderColumn.column.isHidden() && !graderColumn.column.externalGrade, 'grader-column': true}">
    <div bb-content-item-icon show-alert-icon="graderColumn.showAlertIcon()" content-column="graderColumn.column"
      class="element-image" ng-class="{'submission-nav-link': graderColumn.itemLinkIsClickable}"
      ng-if="graderColumn.column" ng-click="graderColumn.handleColumnClick('icon')"
      analytics-id="components.directives.grade.graderColumn.icon.link" aria-hidden="true">
    </div>
    <div class="element-details grade-progress">
      <div ng-class="{'gradebook-overall-grade-title': graderColumn.column.externalGrade}">
        <bb-svg-icon id="{{graderColumn.column.id + 'grade-not-visible-icon'}}" size="small"
          ng-if="graderColumn.column.externalGrade && !graderColumn.column.visible" icon="invisible"
          class="visibility-icon" role="img"
          bb-translate-attrs="{'aria-label': 'components.directives.grade.grader-column.aria-label.gradeNotVisible'}"></bb-svg-icon>
        <span class="name ellipse" ng-if="graderColumn.itemLinkIsClickable">
          <a class="submission-nav-link" ng-click="graderColumn.handleColumnClick('title')" href="javascript:void(0);"
            id="{{graderColumn.itemNameColumnId(graderColumn.index)}}"
            analytics-id="components.directives.grade.graderColumn.name.link"
            aria-label="{{graderColumn.columnAriaLabel}}"
            ng-attr-aria-describedby="{{graderColumn.column.externalGrade && !graderColumn.column.visible ? graderColumn.column.id + 'grade-not-visible-icon' : undefined}}">
            {{graderColumn.column.columnName}}
          </a>
        </span>
      </div>
      <span class="name ellipsis" ng-if="!graderColumn.itemLinkIsClickable">
        <span
          id="{{graderColumn.itemNameColumnId(graderColumn.index)}}">{{graderColumn.column.columnName}}</span>
      </span>
      <div class="controls-and-info">
        <div class="name-controls" ng-if="::!graderColumn.column.isOffline()">
        <span class="secondary-text" ng-if="::graderColumn.column.seemsAttemptBased()">
          <span ng-if="graderColumn.column.dueDate && graderColumn.numMissingStudents">
            <span ng-class="{'items-missing': !graderColumn.isDisabled}" bb-translate
              translate-values="{missingCount: graderColumn.numMissingStudents}">components.directives.grade.grader-column.studentsMissing.plural</span>
            <span class="secondary-text" ng-if="graderColumn.shouldShowPipe(PipeIdentifier.NumMissing)">|</span>
          </span>
          <span
            ng-if="graderColumn.column.summary.numStudentSubmissions && graderColumn.column.summary.numEligibleToBeGraded">
            <bb-translate ng-if="graderColumn.column.isDiscussion()" class="submittedCount"
              translate-values="{participatedCount: graderColumn.column.summary.numStudentSubmissions(), totalCount: graderColumn.column.summary.numEligibleToBeGraded}">components.directives.grade.grader-column.studentsParticipated.plural</bb-translate>
            <bb-translate ng-if="!graderColumn.column.isDiscussion()" class="submittedCount"
              translate-values="{submittedCount: graderColumn.column.summary.numStudentSubmissions(), totalCount: graderColumn.column.summary.numEligibleToBeGraded}">components.directives.grade.grader-column.studentsSubmitted.plural</bb-translate>
              <span class="secondary-text" ng-if="graderColumn.shouldShowPipe(PipeIdentifier.NumSubmitted)">|</span>
          </span>
        </span>
        <span class="secondary-text"
          ng-if="::graderColumn.column.isAttendance() && graderColumn.column.summary.averageGradeForStudents">
          <span bb-translate
            translate-values="{percentage: graderColumn.column.summary.averageGradeForStudents}">components.directives.grade.grader-column.attendance.average</span>
            <span class="secondary-text" ng-if="graderColumn.shouldShowPipe(PipeIdentifier.Average)">|</span>
        </span>
        <span ng-if="graderColumn.isSignature">
          <span class="signature-label" bb-translate>components.directives.grade.grader-column.statuses.signature</span>
          <span class="secondary-text" ng-if="graderColumn.shouldShowPipe(PipeIdentifier.Signature)">|</span>
        </span>
        <span ng-if="graderColumn.isFormative">
          <span class="formative-label" bb-translate>components.directives.grade.grader-column.statuses.formative</span>
        </span>
        </div>
        <bb-discussion-info-icon
          ng-if="graderColumn.isDisabled"
          analytics-id="components.directives.grade.graderColumn.infoIcon"
          class="grader-column-info-icon">
        </bb-discussion-info-icon>
      </div>
    </div>
  </div>
</td>

<td role="cell" ng-if="!graderColumn.windowSizeService.isSmallBreakpoint()" class="tabular-cell grader-column category-inline-size gradable-item-interactive-cell-size" aria-describedby="gradable-item-header-category" aria-colindex="2"
  tabindex="-1">
  <span ng-if="!!graderColumn.column.gradebookCategory && !graderColumn.column.gradebookCategory.isUserDefined"
    bb-translate
    title="{{graderColumn.column.gradebookCategory.localizableTitle.languageKey}}">{{graderColumn.column.gradebookCategory.localizableTitle.languageKey}}</span>
  <span ng-if="!graderColumn.column.gradebookCategory" bb-translate>NoCategory.name</span>
  <span class="ellipsis" ng-if="graderColumn.column.gradebookCategory.isUserDefined" bb-translate
    title="{{graderColumn.column.gradebookCategory.localizableTitle.languageKey}}">{{graderColumn.column.gradebookCategory.title}}</span>
</td>

<td role="cell" ng-if="!graderColumn.windowSizeService.isSmallBreakpoint()" class="tabular-cell category-inline-size gradable-item-interactive-cell-size" aria-describedby="gradable-item-header-dueDate"
  aria-colindex="3" tabindex="-1">
  <div ng-if="graderColumn.isCourseView">
    <bb-datetime ng-if="!graderColumn.column.isAttendance()" format="Short" value="graderColumn.column.dueDate">
    </bb-datetime>
    <bb-multiple-dates-tooltip ng-if="graderColumn.shouldShowTooltipForMultipleDates"
      participation-requirements="graderColumn.column.participationRequirements"
      analytics-id="components.directives.grade.graderColumn.multipleDates">
    </bb-multiple-dates-tooltip>
    <span ng-if="graderColumn.column.isAttendance()"
      bb-translate>components.directives.grade.grader-column.attendance.ongoing</span>
  </div>
</td>

<td role="cell" class="tabular-cell grader-column category-inline-size gradable-item-interactive-cell-size"
  aria-describedby="gradable-item-header-status" aria-colindex="4" tabindex="-1">
  <div class="grade-progress" ng-class="{'course-only-grade-status': graderColumn.isCourseView}"
    ng-if="!graderColumn.column.isAttendance()">
    <div ng-switch="graderColumn.column.isCollectExternalSubmissions()">
      <!-- External submission statuses are calculated differently from others since the instructor is initiating the attempt
      when they go to grade the user. Therefore, we want to include people who have no submission as ready to be graded //-->
      <div ng-switch-when="true">
        <a ng-switch="graderColumn.column.summary.getStatus().toString()"
          ng-class="{'submission-nav-link': graderColumn.itemLinkIsClickable}"
          ng-click="graderColumn.handleColumnClick('status')" href="javascript:void(0);"
          analytics-id="components.directives.grade.graderColumn.status.link"
          tabindex="{{ graderColumn.itemLinkIsClickable ? 0 : -1 }}"
          aria-labelledby="{{ graderColumn.itemLinkIsClickable ? graderColumn.gradingStatusAriaLabel(graderColumn.index) : undefined}}">
          <div class="grade-count" ng-switch-when="NEEDS_GRADING">
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}" bb-translate
              translate-values="{count: graderColumn.getNumberEligibleToBeGradedExternalSubmissions()}">
              components.directives.grade.grader-column.statuses.numToGrade.plural
            </span>
          </div>
          <span ng-switch-when="NEEDS_POSTING">
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}" bb-translate
              ng-if="graderColumn.getNumberEligibleToBeGradedExternalSubmissions() === 0">
              components.directives.grade.grader-column.statuses.allGraded
            </span>
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}" bb-translate
              ng-if="graderColumn.getNumberEligibleToBeGradedExternalSubmissions() > 0"
              translate-values="{count: graderColumn.getNumberEligibleToBeGradedExternalSubmissions()}">
              components.directives.grade.grader-column.statuses.numToGrade.plural
            </span>
          </span>
          <span ng-switch-when="ALL_GRADED">
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
              ng-if="graderColumn.getNumberEligibleToBeGradedExternalSubmissions() === 0" bb-translate>
              components.directives.grade.grader-column.statuses.allGraded
            </span>
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
              ng-if="graderColumn.getNumberEligibleToBeGradedExternalSubmissions() > 0" bb-translate
              translate-values="{count: graderColumn.getNumberEligibleToBeGradedExternalSubmissions()}">
              components.directives.grade.grader-column.statuses.numToGrade.plural
            </span>
          </span>
          <div class="grade-progress-complete" ng-switch-when="ALL_POSTED">
            <bb-svg-icon class="grade-progress-icon" size="small" icon="complete" status="success"></bb-svg-icon>
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
              bb-translate>components.directives.grade.grader-column.statuses.allPosted</span>
          </div>
          <span ng-switch-when="NOTHING_TO_GRADE">
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
              ng-if="graderColumn.getNumberEligibleToBeGradedExternalSubmissions() === 0" bb-translate>
              components.directives.grade.grader-column.statuses.nothingToGrade
            </span>
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
              ng-if="graderColumn.getNumberEligibleToBeGradedExternalSubmissions() > 0" bb-translate
              translate-values="{count: graderColumn.getNumberEligibleToBeGradedExternalSubmissions()}">
              components.directives.grade.grader-column.statuses.numToGrade.plural
            </span>
          </span>
          <div class="grade-progress-restricted" ng-switch-when="RESTRICTED">
            <bb-button-complex-tooltip></bb-button-complex-tooltip>
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
              bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
          </div>
        </a>
      </div>
      <div ng-switch-default>
        <a ng-if="::!graderColumn.isScorable() && graderColumn.getStatus()" ng-class="{'submission-nav-link': graderColumn.itemLinkIsClickable}"
          ng-click="graderColumn.handleColumnClick('status')" href="javascript:void(0);"
          analytics-id="components.directives.grade.graderColumn.status.link"
          tabindex="{{ graderColumn.itemLinkIsClickable ? 0 : -1 }}"
          aria-labelledby="{{ graderColumn.itemLinkIsClickable ? graderColumn.gradingStatusAriaLabel(graderColumn.index) : undefined}}">
          <span id="{{ 'grading-status-id_' + graderColumn.index }}" bb-translate>
            {{graderColumn.getStatus()}}
          </span>
        </a>
        <a ng-switch="graderColumn.column.summary.getStatus().toString()"
          ng-if="::graderColumn.showGradeStatusForNonCalculated()"
          ng-class="{'submission-nav-link': graderColumn.itemLinkIsClickable}"
          ng-click="graderColumn.handleColumnClick('status')" href="javascript:void(0);"
          analytics-id="components.directives.grade.graderColumn.status.link"
          tabindex="{{ graderColumn.itemLinkIsClickable ? 0 : -1 }}"
          aria-labelledby="{{ graderColumn.itemLinkIsClickable ? graderColumn.gradingStatusAriaLabel(graderColumn.index) : undefined}}">
          <div class="grade-count js-grade-progress-needs-grading" ng-switch-when="NEEDS_GRADING">
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}" ng-if="::graderColumn.column.isOffline()"
              bb-translate translate-values="{count: graderColumn.column.summary.numStudentsNeedsGrading}">
              components.directives.grade.grader-column.statuses.numToGrade.plural
            </span>
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}" ng-if="::!graderColumn.column.isOffline()"
              bb-translate translate-values="{count: graderColumn.getNumberOfSubmissionsNeedsGrading()}">
              components.directives.grade.grader-column.statuses.numToGrade.plural
            </span>
          </div>
          <span ng-switch-when="NEEDS_POSTING" id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
            bb-translate>components.directives.grade.grader-column.statuses.allGraded</span>
          <span class="js-grade-progress-all-graded" ng-switch-when="ALL_GRADED"
            id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
            bb-translate>components.directives.grade.grader-column.statuses.allGraded</span>
          <div class="grade-progress-complete" ng-switch-when="ALL_POSTED">
            <bb-svg-icon class="grade-progress-icon" size="small" icon="complete" status="success"></bb-svg-icon>
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
              bb-translate>components.directives.grade.grader-column.statuses.allPosted</span>
          </div>
          <span class="js-grade-progress-nothing-to-show" ng-switch-when="NOTHING_TO_GRADE"
            id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
            bb-translate>components.directives.grade.grader-column.statuses.nothingToGrade</span>
          <div class="grade-progress-restricted" ng-switch-when="RESTRICTED">
            <bb-button-complex-tooltip></bb-button-complex-tooltip>
            <span id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}"
              bb-translate>components.directives.grade.grader-column.statuses.restricted</span>
          </div>
        </a>
        <div ng-if="::graderColumn.column.isCalculated()"><!-- Needed for spacing --></div>
      </div>
    </div>
  </div>
  <div class="grade-progress"
    ng-if="graderColumn.column.isAttendance()">
    <a ng-class="{'submission-nav-link': graderColumn.itemLinkIsClickable}"
      ng-click="graderColumn.handleColumnClick('status')" href="javascript:void(0);"
      analytics-id="components.directives.grade.graderColumn.status.link"
      tabindex="{{ graderColumn.itemLinkIsClickable ? 0 : -1 }}"
      aria-labelledby="{{ graderColumn.itemLinkIsClickable ? graderColumn.gradingStatusAriaLabel(graderColumn.index) : undefined}}"
      id="{{graderColumn.gradingStatusColumnId(graderColumn.index)}}" bb-translate>
      components.directives.grade.grader-column.attendance.markAttendance
    </a>
  </div>
</td>

<td role="cell" class="tabular-cell grader-column category-inline-size gradable-item-interactive-cell-size"
  aria-describedby="gradable-item-header-post" aria-colindex="5" tabindex="-1">
  <div class="grade-status">
    <div ng-if="::!graderColumn.column.isCalculated()">
      <div
        ng-if="!graderColumn.isCourseComplete() && graderColumn.column.summary.hasGradesToPost() && graderColumn.canPostGrades"
        class="post">
        <button class="button button--secondary send-grade"
          bb-confirmation-needed="{{graderColumn.grade.getPostAllGradeConfirmationNeededStringsKey(graderColumn.column)}}"
          modal-aria-type="alertdialog" show-type="always" ng-click="graderColumn.postGrades()"
          bb-translate-attrs="{'aria-label': 'components.directives.grade.grader-column.aria-label.postGrades'}"
          translate-attrs-values="{courseName: graderColumn.course.name, columnName: graderColumn.column.columnName}"
          bb-translate="{{graderColumn.isCourseView ? 'components.directives.grade.grader-column.actions.postGradesWithLocalizedCount' : 'components.directives.grade.grader-column.actions.basePostGradesWithLocalizedCount'}}"
          translate-values="{count : graderColumn.column.summary.totalNumberOfGradesToPost()}"
          analytics-id="{{graderColumn.isCourseView ? 'components.directives.grade.grader-column.actions.postGradesWithLocalizedCount' : 'components.directives.grade.grader-column.actions.basePostGradesWithLocalizedCount'}}">
        </button>
      </div>
    </div>
    <div ng-if="::graderColumn.column.isCalculated()"><!-- Needed for spacing --></div>
  </div>
</td>

<td role="cell" aria-describedby="gradable-item-header-drag-drop" class="tabular-cell action-inline-size" aria-colindex="6" tabindex="-1">
  <div class="grader-column" bb-foundation-defer>
    <button bb-drag-handle ng-if="graderColumn.showDragControls" drag-item-id="{{::graderColumn.column.id}}"
      drag-item-name="{{graderColumn.column.columnName}}"
      class="super-clear small button icon js-drag-handle drag-drop-button"
      bb-translate-attrs="{'aria-label': 'components.directives.grade.grader-column.aria-label.reorder-grader-item', 'title': 'components.directives.grade.grader-column.aria-label.move-tip'}"
      translate-attrs-values="{columnName: graderColumn.column.columnName}"
      analytics-id="components.directives.grade.graderColumn.reorderItem.button"
    >
      <bb-svg-icon size="small" icon="move-item-up-down"></bb-svg-icon>
    </button>
  </div>
</td>

<td role="cell" aria-describedby="gradable-item-header-overflow" class="tabular-cell grader-column last-row-item item-controls dots action-column" bb-foundation-defer aria-colindex="7"
  tabindex="-1">
  <div ng-if="graderColumn.showOverflowMenu" class="overflow-menu-container right">
    <bb-overflow-menu element-id="{{graderColumn.overflowMenuId}}" element-name="{{graderColumn.column.columnName}}"
      menu-items="graderColumn.getOverflowMenuItems()"
      analytics-id-tag-prefix="components.directives.grade.grader-column.overflowMenu">
    </bb-overflow-menu>
    <send-reminders-dialog show-dialog="graderColumn.showReminderModal" course-id="graderColumn.course.id"
      column-id="graderColumn.column.id" dialog-callback="graderColumn.resetShowModal"
      is-group="graderColumn.column.groupContent"
      num-students-not-submitted="graderColumn.getStudentsNoSubmissionCount()"></send-reminders-dialog>
  </div>
</td>

<td ng-if="graderColumn.showConversionMessage">
<div>
  <bb-course-access-alert course="course"
                          alert-type="graderColumn.getAlertType()"
                          confirm-callback="graderColumn.closeConversionTooltip()"
                          timeout-callback="graderColumn.closeConversionTooltip()">
  </bb-course-access-alert>
</div>
</td>
