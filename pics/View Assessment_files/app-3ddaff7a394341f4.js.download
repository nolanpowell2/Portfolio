 </bb-context-menu-add-button>
`},364305(e){e.exports=`<div class="content-item-icon" bb-load-bundle="components/directives/element-image/element-image-accessibility">
  <div ng-if= "!contentItemIcon.customLtiIcon">
    <bb-ui-content-icon icon="contentItemIcon.iconName" color="{{contentItemIcon.iconColor}}" not-decorative="true" ng-if="!isMediumContentItemIcon"></bb-ui-content-icon>
    <content-icon-medium icon="contentItemIcon.iconName" color="contentItemIcon.iconColor" ng-if="isMediumContentItemIcon" class="js-{{contentItemIcon.iconName}}-icon"></content-icon-medium>
  </div>
  <div class="image-wrapper" ng-if="contentItemIcon.customLtiIcon">
    <img bb-translate-attrs="{'alt': 'components.directives.element-image.element-image-accessibility.img-icon-' + contentItemIcon.iconName }" ng-src="{{ ::contentItemIcon.customLtiIcon }}" />
  </div>
</div>
`},86407(e){e.exports=`<div bb-foundation-defer bb-load-bundle="components/directives/content-visibility" dev-suppress-hide="true">
  <div class="restricted-form content-visibility-rules-container">
    <div class="row collapse">
      <div class="columns small-12 js-from-checkbox">
        <input type="checkbox"
               ng-model="contentVisibilityRulesOptions.startDateSelect"
               class="from-check"
               id="from-check-{{contentVisibilityRulesOptions.id}}"
               name="fromCheck"
               ng-change="contentVisibilityRulesOptions.handleCheckClick('from-check')"
               ng-show="!isReadOnlyMode()"
               analytics-id="content.visibility.rules.options.startDateSelect.input.checkbox"/>
        <label class="date-time-label" for="from-check-{{contentVisibilityRulesOptions.id}}" ng-show="!isReadOnlyMode()"
          bb-translate>course.conditionalRelease.rules.dateTimeCriteria.accessFromSection.checkboxLabel</label>
        <label class="date-time-label"
          ng-show="isReadOnlyMode() && (contentVisibilityRulesOptions.startDateSelect || isAllowedEmpty)"
          bb-translate>
          course.conditionalRelease.rules.dateTimeCriteria.accessFromSection.checkboxLabel
        </label>
      </div>
      <div
        ng-show="contentVisibilityRulesOptions.startDateSelect || !isReadOnlyMode() || (isAllowedEmpty && isReadOnlyMode())"
        class="columns small-12">
        <div class="row collapse date-time-inputs" ng-class="{'read-only-fields': isReadOnlyMode()}">
          <div class="columns small-6 js-date-input-container {{contentVisibilityRulesOptions.dateFromContainer}}"
            ng-class="{'read-only-form-field': isReadOnlyMode(), 'form-field-disabled': contentVisibilityRulesOptions.timeDateFromDisabled}">
            <!-- htmlhint:analytics-id:disable -->
            <input id="date-from"
                   bb-date-picker
                   orientation="auto left"
                   container=".{{contentVisibilityRulesOptions.dateFromContainer}}"
                   ng-model="startDate" name="dateFrom" aria-describedby="date-from-error"
                   ng-model-options="{ allowInvalid: true }"
                   first-day-of-week="contentVisibilityRulesOptions.localeSettings.calendar.firstDayOfWeek"
                   bb-validate-date
                   ng-class="{'read-only-field': isReadOnlyMode()}"
                   ng-attr-bb-focus="contentVisibilityRulesOptions.shouldFocus('start-date')"
                   ng-blur="contentVisibilityRulesOptions.updateStartAndEndTime()"
                   ng-required="contentVisibilityRulesOptions.isDateRequired(true)"
                   ng-change="contentVisibilityRulesOptions.updateStartAndEndTime()"
                   ng-disabled="contentVisibilityRulesOptions.timeDateFromDisabled"
                   bb-translate-attrs="{'aria-label': 'course.conditionalRelease.rules.dateTimeCriteria.accessFromSection.dateAriaLabel',
                       'placeholder': 'components.directives.content-visibility.datePlaceholder'}"
                   analytics-id="content.visibility.rules.options.startDate.input.text"/>
              <!-- htmlhint:analytics-id:enable -->
          </div>
          <div class="columns small-6 input group"
            ng-class="{'read-only-form-field': isReadOnlyMode(), 'form-field-disabled': contentVisibilityRulesOptions.timeDateFromDisabled}">
            <bb-time-picker name="timeFrom"
                            id="time-from"
                            aria-describedby="time-from-error"
                            invalid-validation-key="time"
                            analytics-id="content.visibility.rules.options.startDate.input.text"
                            ng-model="startTime"
                            disabled="contentVisibilityRulesOptions.timeDateFromDisabled"
                            bb-translate-attrs="{'aria-label': 'course.conditionalRelease.rules.dateTimeCriteria.accessFromSection.timeAriaLabel',
                                'placeholder': 'components.directives.content-visibility.timePlaceholder'}"
            ></bb-time-picker>
          </div>
        </div>
      </div>
    </div>
    <div class="row collapse">
      <div class="columns small-12">
        <div bb-validation-messages for="dateFrom" class="row collapse" id="date-from-error">
            <span ng-message="required">
                <bb-translate>components.directives.content-visibility.startDateError</bb-translate>
              </span>
          <span ng-message="date" bb-translate>
            {{::contentVisibilityRulesOptions.setErrorString(true, true)}}
          </span>
          <span ng-message="startAndOrEndDate">
            <bb-translate>components.directives.content-visibility.startAndOrEndDateError</bb-translate>
          </span>
          <span ng-message="startAndOrEndDateOnsubmit">
            <bb-translate>components.directives.content-visibility.startAndOrEndDateError</bb-translate>
          </span>
          <span ng-message="startBeforeDueDate">
            <bb-translate>components.directives.content-visibility.dueDateBeforeError</bb-translate>
          </span>
          <span ng-transclude="customStartDateAndTimeValidationMessages"></span>
        </div>
      </div>
      <div bb-validation-messages for="timeFrom" class="row collapse" id="time-from-error">
          <span ng-message="required">
              <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.emptyTime.accessFrom</bb-translate>
          </span>
        <span ng-message="time">
            {{::contentVisibilityRulesOptions.setErrorString(false, true)}}
        </span>
        <span ng-message="required">
          <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.emptyTime.accessFrom</bb-translate>
        </span>
        <span ng-transclude="customStartDateAndTimeValidationMessages"></span>
      </div>
    </div>
    <div class="row collapse">
      <div class="columns small-12 js-until-checkbox">
        <input type="checkbox"
               ng-model="contentVisibilityRulesOptions.untilDateSelect"
               class="until-check"
               id="until-check-{{contentVisibilityRulesOptions.id}}"
               name="untilCheck"
               ng-change="contentVisibilityRulesOptions.handleCheckClick('until-check')"
               ng-show="!isReadOnlyMode()"
               analytics-id="content.visibility.rules.options.untilDate.input.checkbox"/>
        <label class="date-time-label" for="until-check-{{contentVisibilityRulesOptions.id}}"
          ng-show="!isReadOnlyMode()" bb-translate>course.conditionalRelease.rules.dateTimeCriteria.accessUntilSection.checkboxLabel</label>
        <label class="date-time-label"
          ng-show="isReadOnlyMode() && (contentVisibilityRulesOptions.untilDateSelect || isAllowedEmpty)" bb-translate>
          course.conditionalRelease.rules.dateTimeCriteria.accessUntilSection.checkboxLabel
        </label>
      </div>
      <div
        ng-show="contentVisibilityRulesOptions.untilDateSelect || !isReadOnlyMode() || (isAllowedEmpty && isReadOnlyMode())"
        class="columns small-12">
        <div class="row collapse date-time-inputs" ng-class="{'read-only-fields': isReadOnlyMode()}">
          <div class="columns small-6 js-date-input-container {{contentVisibilityRulesOptions.dateUntilContainer}}"
            ng-class="{'read-only-form-field': isReadOnlyMode(), 'form-field-disabled': contentVisibilityRulesOptions.timeDateUntilDisabled}">
            <!-- htmlhint:analytics-id:disable -->
            <input id="date-until"
                   bb-date-picker
                   orientation="auto left"
                   container=".{{contentVisibilityRulesOptions.dateUntilContainer}}"
                   ng-model="endDate"
                   ng-model-options="{ allowInvalid: true }"
                   first-day-of-week="contentVisibilityRulesOptions.localeSettings.calendar.firstDayOfWeek"
                   bb-validate-date
                   name="dateUntil"
                   aria-describedby="date-until-error" ng-class="{'read-only-field': isReadOnlyMode()}"
                   ng-attr-bb-focus="contentVisibilityRulesOptions.shouldFocus('end-date')"
                   ng-blur="contentVisibilityRulesOptions.updateStartAndEndTime()"
                   ng-change="contentVisibilityRulesOptions.updateStartAndEndTime()"
                   ng-required="contentVisibilityRulesOptions.isDateRequired(false)"
                   ng-disabled="contentVisibilityRulesOptions.timeDateUntilDisabled"
                   bb-translate-attrs="{'aria-label': 'course.conditionalRelease.rules.dateTimeCriteria.accessUntilSection.dateAriaLabel',
                       'placeholder': 'components.directives.content-visibility.datePlaceholder'}"
                   analytics-id="content.visiblity.rules.options.endDate.input.input.text"/>
            <!-- htmlhint:analytics-id:enable -->
          </div>
          <div class="columns small-6 input group"
            ng-class="{'read-only-form-field': isReadOnlyMode(), 'form-field-disabled': contentVisibilityRulesOptions.timeDateUntilDisabled}">
            <bb-time-picker name="timeUntil"
                            id="time-until"
                            aria-describedby="time-until-error"
                            analytics-id="content.visibility.rules.options.endDate.input.text"
                            ng-model="endTime"
                            disabled="contentVisibilityRulesOptions.timeDateUntilDisabled"
                            invalid-validation-key="time"
                            bb-translate-attrs="{'aria-label': 'course.conditionalRelease.rules.dateTimeCriteria.accessUntilSection.timeAriaLabel',
                                'placeholder': 'components.directives.content-visibility.timePlaceholder'}"
            ></bb-time-picker>
          </div>
        </div>
      </div>
    </div>
    <div class="row collapse">
      <div class="columns small-12">
        <div bb-validation-messages for="dateUntil" class="row collapse" id="date-until-error">
          <span ng-message="required">
            <bb-translate>components.directives.content-visibility.endDateError</bb-translate>
          </span>
          <span ng-message="date">
            {{::contentVisibilityRulesOptions.setErrorString(true, false)}}
          </span>
          <span ng-message="requiredOnsubmit">
            <bb-translate>components.directives.content-visibility.endDateError</bb-translate>
          </span>
          <span ng-message="untilAfterStart">
            <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.endDateOnOrBeforeStartDate</bb-translate>
          </span>
          <span ng-message="untilAfterStartOnsubmit">
            <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.endDateOnOrBeforeStartDate</bb-translate>
          </span>
          <span ng-message="untilDueDate">
            <bb-translate>components.directives.content-visibility.dueDateAfterError</bb-translate>
          </span>
          <span ng-message="subsequentDueDate">
            <bb-translate>components.directives.content-visibility.subsequentDueDateAfterError</bb-translate>
          </span>
          <span ng-transclude="customEndDateAndTimeValidationMessages"></span>
        </div>
      </div>
      <div bb-validation-messages for="timeUntil" class="row collapse" id="time-until-error">
        <span ng-message="time">
           {{::contentVisibilityRulesOptions.setErrorString(false, false)}}
        </span>
        <span ng-message="required">
          <bb-translate>course.conditionalRelease.rules.dateTimeCriteria.errorMessages.emptyTime.accessUntil</bb-translate>
        </span>
        <span ng-transclude="customEndDateAndTimeValidationMessages"></span>
      </div>
    </div>
  </div>
</div>
`},101141(e){e.exports=`<ng-switch on="targetContent.contentHandler.toString()">
  <a ng-switch-when="resource/x-bb-blti-link" 
     bb-component-sref="{{prefix}}.engagement.edit({contentId:'{{targetContent.id}}'})"
     class="content-title"
     analytics-id="course.content.lti.link"><span>{{ content.title }}</span></a>
</ng-switch>
`},134307(e){e.exports=`<div class="panel-header persistent-white-header mode-{{mode}} panel-header-directive"
  bb-load-bundle="components/directives/panel-header"
  ng-class="{'is-editable' : panelHeader.editMode,
   'has-slider': hasSlider(),
   'can-edit': canEdit,
   'has-controls': showConversations() || showDelete() || showParticipants() || showSettings(),
   'has-visibility-toggle': showVisibility(),
   'compressed': isUnlabeled()}">
  <div class="panel-titles-container">
    <div ng-if="showCourse() && !isUnlabeled()">
      <div class="panel-sub-title js-vr-remove-random">
        <span ng-if="::!panelHeaderTitleTranslateKey">{{panelHeader.panelHeaderTitle}}</span>
        <span ng-if="::panelHeaderTitleTranslateKey" bb-translate>{{::panelHeaderTitleTranslateKey}}</span>
      </div>
    </div>
    <div class="panel-title-texteditor">
      <div class="editable-title-container" ng-show="!panelHeader.editMode">
        <!-- ULTRA-13692 Since there's already an "Edit" button, we don't want keyboard users to be able to focus on the title to edit it,
             otherwise there would be two ways to edit the title, which is confusing. However, since this title has an event listener, it's
             announced as "clickable" by screenreaders, so let's hide it with aria-hidden and add another instance of the header just for
             screenreaders instead. -->
        <h1 class="sr-only" tabindex="-1" aria-hidden="true">{{panelTitle}}</h1>
        <h1 class="panel-title secondary-title" ng-click="panelHeader.onEditMode()"
            ng-keydown="panelHeader.titlePressKey($event)"
            bb-focus="!disableTitleFocus && !disableTitleAutofocus && !panelHeader.editMode"
            ng-blur="panelHeader.blurTitle($event)"
            ng-class="{'student' : !canEdit, 'is-hovered': panelHeader.isEditButtonHovering}" title="{{panelTitle}}"
            analytics-id="components.directives.content.panelHeader.secondaryTitle.header">
             <!-- When announcing the title to screen readers, include the heading as well -->
            <span class="sr-only">{{panelHeader.panelHeaderTitle}}</span>{{panelTitle}}
        </h1>
        <button ng-if="canEdit" class="button super-clear edit-title" type="button"
                ng-click="panelHeader.onEditMode()"
                ng-mouseover="panelHeader.onEditButtonMouseOver()"
                ng-mouseleave="panelHeader.onEditButtonMouseLeave()"
                aria-label="{{ panelHeader.getAriaLabel() }}"
                analytics-id="course.content.panelHeader.edit.button">
          <bb-svg-icon size="small" icon="draw" aria-hidden="true"></bb-svg-icon>
        </button>
        <button ng-if="showLockIcon"
          class="icon super-clear button"
          type="button"
          analytics-id="course.content.panelHeader.locked.button"
          bb-tooltip enhanced-tooltip="true" tooltip-position="bottom"
          tooltip-center-content="true" tooltip-enable-on-mouse-over-for-all-breakpoints="true"
          tooltip-enable-on-mouse-leave-for-all-breakpoints="true"
          bb-translate-attrs="{'title':'components.directives.header.managedByInstitution'}"
        >
          <bb-svg-icon size="small" icon="lock" aria-hidden="true"></bb-svg-icon>
        </button>
      </div>
      <div class="panel-title-input-container" ng-show="panelHeader.editMode" bb-click-outside="panelHeader.onBlurTitle()">
        <input
          name="panel-title"
          class="panel-header-title panel-title secondary-title"
          type="text"
          autocapitalize="off"
          ng-keydown="panelHeader.pressKey($event)"
          maxlength="{{maxLength}}"
          ng-model="panelTitle"
          ng-model-options="{ getterSetter: true }"
          ng-blur="panelHeader.onBlurTitle($event)"
          ng-change="panelHeader.onChangeTitle()"
          bb-translate-attrs="{'aria-label':'{{::panelHeader.panelTitleInputAriaLabelKey}}'}"
          bb-placeholder="{{::panelHeader.translatedPlaceholder}}"
          translate-attrs-values="{{::localizationAttrsValues}}"
          analytics-id="course.content.panelHeader.title.input.text"
          >
      </div>
    </div>
  </div>

  <div
    class="header-actions-menu button-group header-group"
    ng-class="panelHeader.getButtonGroupClass()">

    <ng-transclude ng-transclude-slot="panelHeaderActions"></ng-transclude>

    <div ng-if="showVisibility()"
         class="action-item item-visibility"
         ng-class="{'visibility-selector-disabled': !panelHeader.isVisibilitySelectorEnabled()}">

      <bb-content-visibility-selector ng-if="content" content="content"
                                      disabled="content.isEditable()"
                                      is-visibility-selector-enabled="panelHeader.isVisibilitySelectorEnabled()"
                                      onchange-func="panelHeader.onChangeVisibility()"
                                      open-panel-on-restricted="openPanelOnRestricted()"
                                      on-restricted-selected-func="panelHeader.onRestrictedSelected()"
                                      validation-func="panelHeader.validateVisibilityChange(visibility)"
                                      onblur-func="panelHeader.onBlurVisibility()"
                                      disable-restricted="disableRestricted()"
                                      has-medium-icon="false"></bb-content-visibility-selector>
    </div>

    <div class="ally-icons" ng-if="showAllyIcon() && panelHeader.canShowAlly">
      <div class="small-ally-icon">
        <bb-ally-show content-id="{{::content.id}}" show-alternative-formats-link="true" show-icon="true"
          class="ally-icon"></bb-ally-show>
      </div>
      <div class="medium-ally-icon">
        <bb-ally-show content-id="{{::content.id}}" show-alternative-formats-link="true" show-icon="true" icon-size="medium"
          class="ally-icon"></bb-ally-show>
      </div>
    </div>

    <div ng-if="showConversations() && content.ui.hasConversationAttached && content.attachedForumLink"
         class="action-item conversation"
         ui-sref-active="active">
      <button ng-click="panelHeader.gotoConversation()"
         bb-translate-attrs="{'aria-label':'components.directives.header.conversationAriaLabel', 'title':'components.directives.header.conversation'}"
         translate-attrs-values="{itemTitle: panelTitle}"
         class="button super-clear icon open-conversation"
         type="button"
         analytics-id="panel.header.conversation.visibility.button">
        <bb-svg-icon size="medium" icon="conversation"></bb-svg-icon>
      </button>
    </div>
    <div ng-if="showDelete()"
         class="action-item delete"
         ng-class="{'delete-button': showDelete() && showSettings()}"
         ui-sref-active="active">
      <ng-switch on="panelHeader.getDeleteDirectiveArgumentType()">
        <bb-delete ng-switch-when="ContentOnly" extra-class="standard-button" content="content" choices="choices" analytics-id="panel.header.content.only.switch"></bb-delete>
        <bb-delete ng-switch-when="ContentAndDelete" extra-class="standard-button" content="content" delete-function="ondeleteFunc()" choices="choices" analytics-id="panel.header.content.delete.button.switch"></bb-delete>
        <bb-delete ng-switch-when="ContentAndHandler" extra-class="standard-button" content="content" confirmation-handler="{{ondeleteConfirmHandler}}" choices="choices" analytics-id="panel.header.content.header.button.switch"></bb-delete>
        <bb-delete ng-switch-when="ContentAndDeleteAndHandler" extra-class="standard-button" content="content" delete-function="ondeleteFunc()" confirmation-handler="{{ondeleteConfirmHandler}}" choices="choices" analytics-id="panel.header.content.delete.handler.button.switch"></bb-delete>
        <bb-delete ng-switch-when="DeleteAndHandler" extra-class="standard-button" delete-function="ondeleteFunc()" confirmation-handler="{{ondeleteConfirmHandler}}" choices="choices" analytics-id="panel.header.delete.handler.button.switch"></bb-delete>
      </ng-switch>
    </div>
    <div ng-if="showParticipants()"
         class="action-item item-visibility header-action-icon participants"
         ui-sref-active="active">
      <a bb-peek-sref="discussion-participants"
         bb-translate-attrs="{'aria-label':'components.directives.header.participants'}"
         class="button super-clear icon"
         analytics-id="components.directives.discussion.participants.link">
        <bb-svg-icon ng-if="!content.isGroupContent" size="medium" icon="people"></bb-svg-icon>
        <bb-svg-icon ng-if="content.isGroupContent" size="medium" icon="groups"></bb-svg-icon>
      </a>
    </div>

    <div ng-if="showSettings() && !!settingsPeekRef"
         class="action-item item-visibility header-action-icon settings"
         ui-sref-active="active">
      <a class="button super-clear icon assessment-settings-button"
         href="javascript:void(0);"
         ng-class="{'disabled': settingsDisabled()}"
         ng-click="panelHeader.openSettingsPanel()"
         bb-translate-attrs="{'aria-label':'{{settingsLabel}}'}"
         analytics-id="panel.header.open.settings.panel.link">
        <bb-svg-icon size="medium" icon="{{::panelHeader.getSettingsIcon()}}"></bb-svg-icon>
      </a>
    </div>
    <ng-transclude ng-transclude-slot="panelHeaderCustomIcons" />
  </div>
  <div class="graded-count-wrap" ng-if="showSubmissionsGrading()">
    <div class="graded-count-wrap-col col-numbers">
      <div class="graded-numbers"
      ng-if="showSubmissionsGrading() && summary.$resolved"
      bb-translate="components.directives.header.submissions-grading.gradedCount.numbers"
      translate-values="{gradedCount: summary.numStudentsGraded(), totalCount: summary.numEligibleToBeGraded}"
      >
      </div>
      <div class="filtered-numbers" ng-if="showSubmissionsGrading() && isFiltered" bb-translate="components.directives.header.submissions-grading.filteredCount.numbers"
      translate-values="{filteredCount}">
      </div>
    </div>
    <div class="graded-count-wrap-col">
      <p class="graded-label" ng-if="showSubmissionsGrading() && summary.$resolved" bb-translate="components.directives.header.submissions-grading.gradedCount.plural"></p>
      <p class="graded-label" ng-if="showSubmissionsGrading() && isFiltered" bb-translate="components.directives.header.submissions-grading.filteredCount.plural"></p>
    </div>
  </div>
</div>
`},251928(e){e.exports=`<div ng-if="conversionStatusBarController.showStatusBar && !conversionStatusBarController.inPreview"
     class="conversion-status-bar import-learn-bar" ng-class="{'below': conversionStatusBarController.hideStatusBar()}"
     bb-load-bundle="components/directives/conversion-status-bar" role="banner">
  <div class="conversion-prompt-container">
    <div class="conversion-prompt-title" bb-translate="course.conversion.statusBar.useUltraPromptTitle" course-org-token-resolver>
    </div>
    <div class="conversion-prompt-details" bb-translate="course.conversion.statusBar.useUltraPromptDetails" course-org-token-resolver>
    </div>
    <a class="hide-for-medium-only hide-for-small-only"
        bb-translate="course.conversion.statusBar.moreInfoLink" bb-translate-attrs="{ 'href': 'course.conversion.statusBar.moreInfoLinkUrl' }"
        target="_blank" rel="noopener noreferrer"
        analytics-id="course.conversion.statusBar.moreInfoLink"></a>
  </div>
  <div class="conversion-button-container">
    <a href="javascript:void(0);" class="js-back-to-classic conversion-button conversion-return-classic show-for-large-up"
        ng-click="conversionStatusBarController.backToClassic()" component-key="conversionBackToClassic"
        analytics-id="course.conversion.statusBar.backToClassic">
      <bb-translate course-org-token-resolver>course.conversion.statusBar.backToClassic</bb-translate>
    </a>
    <button class="js-back-to-classic conversion-button conversion-return-button button button--secondary"
        ng-click="conversionStatusBarController.backToClassic()" component-key="conversionBackToClassic"
        analytics-id="course.conversion.statusBar.backToClassic.button">
      <span bb-translate="course.conversion.statusBar.backToClassic" course-org-token-resolver></span>
    </button>
    <button class="js-use-new-ux conversion-button button default" ng-click="conversionStatusBarController.useTheNewExperience()"
            bb-confirmation-needed="resource/x-bb-course-conversion" show-type="always"  confirmation-course-org-token-resolver
            analytics-id="course.conversion.statusBar.useUltra.button">
      <span bb-translate="course.conversion.statusBar.useUltra" course-org-token-resolver></span>
    </button>
  </div>
</div>
`},713836(e){e.exports=`<bb-modal class="notification js-dismiss-modal" role="alertdialog" bb-translate-attrs="{'aria-label': 'course.outline.previewCourse.alert.modalTitle'}"
